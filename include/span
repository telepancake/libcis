// <span> — mechanically ported from libc++ include/span
// Target: gcc-10.2, -std=gnu++20 -fno-exceptions -fno-rtti
//
// Covers: dynamic_extent, span<T,Extent> (static and dynamic),
//   all constructors, first/last/subspan (static and dynamic),
//   observers, element access, iterators, as_bytes, as_writable_bytes,
//   deduction guides, enable_borrowed_range/enable_view specialisations.
//
// The span class itself lives in <bits/span.h> so that <ranges>'s
// views::counted (which returns a span and needs span's deduction guides) can
// see it while span still depends on the core <ranges> concepts — see the
// header comment in <bits/span.h> for the cycle-breaking rationale. <ranges>
// pulls <bits/span.h> in at the right point; including <ranges> here therefore
// makes span complete no matter which of <span>/<ranges> a TU reaches first.
//
// std::reverse_iterator comes from <iterator> (the canonical home).
#pragma once

#include <type_traits>
#include <concepts>
#include <cstddef>
#include <array>
#include <iterator>
#include <ranges>
#include <bits/span.h>
