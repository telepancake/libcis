// <vector> — lean profile: one-pointer representation over a lean block.
//
// sizeof(vector<T>) == sizeof(void*). The single pointer addresses the payload
// of a lean block (bits/lean.h): the element array, with the element count
// (`used`) stored just before it and the capacity recomputed from the block's
// usable size. A null pointer is the empty vector (data() == nullptr,
// begin() == end(), capacity() == 0).
//
// Structural work (grow, insert-gap, erase, shrink, assign-copy) is done by the
// non-template kernels in bits/lean_array.h, shared by every element type. Only
// the hot inline bits and per-element construction from foreign iterators /
// ctor args stay templated here. Iterators are plain T*.
//
// Deviations from base <vector> (all deliberate, see lean/README.md):
//   * No custom allocators: the Allocator parameter is kept for source
//     compatibility but static_assert'd to allocator<T>; all storage is
//     malloc/realloc/free. get_allocator() returns a default allocator.
//   * No std::pmr::vector alias.
//   * Container members are not constexpr (lean targets a no-constexpr-alloc
//     compiler and type-erases the bulk operations).
//   * Over-aligned element types (alignof(T) > alignof(max_align_t)) rejected.
//   * Allocation failure traps (__builtin_trap), matching -fno-exceptions.
//   * vector<bool>: one-pointer bit block; the standard proxy-reference minimum
//     plus common capacity/access ops. Omitted: insert/emplace/erase, hash<>,
//     the free swap(reference,reference) overloads (see the notes there).
#pragma once

#include <bits/lean_array.h>
#include <memory>
#include <algorithm>
#include <initializer_list>
#include <iterator>
#include <compare>
#include <limits>
#include <climits>
#include <type_traits>
#include <utility>
#include <cstddef>

namespace std {

//===----------------------------------------------------------------------===//
// vector<T, Allocator>
//===----------------------------------------------------------------------===//

template<class T, class Allocator = allocator<T>>
class vector {
    static_assert(detail::lean_allocator_ok<T, Allocator>,
        "lean vector supports only std::allocator<T> (custom allocators are a "
        "documented deviation of the lean profile)");
    static_assert(alignof(T) <= alignof(max_align_t),
        "lean vector does not support over-aligned element types");

public:
    using value_type             = T;
    using allocator_type         = Allocator;
    using reference              = value_type&;
    using const_reference        = const value_type&;
    using size_type              = size_t;
    using difference_type        = ptrdiff_t;
    using pointer                = value_type*;
    using const_pointer          = const value_type*;
    using iterator               = pointer;
    using const_iterator         = const_pointer;
    using reverse_iterator       = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;

private:
    // The lone data member: sizeof(vector) == sizeof(void*).
    void* p_ = nullptr;

    static const detail::lean_ops* ops() noexcept { return &detail::lean_ops_for<T>; }

    // The `used` counter lives inside the block; only valid when p_ != null.
    void set_size(size_type n) noexcept { detail::lean_used(p_) = n; }

    void reset() noexcept {
        if (p_) {
            detail::lean_arr_destroy(p_, ops(), 0, detail::lean_used(p_));
            detail::lean_free(p_, alignof(T));
            p_ = nullptr;
        }
    }

    // Geometric growth target (in elements) for holding `need` elements.
    size_type recommend(size_type need) const {
        const size_type ms = max_size();
        if (need > ms)
            __builtin_trap();          // would be length_error
        const size_type cap = capacity();
        if (cap >= ms / 2)
            return ms;
        const size_type twice = 2 * cap;
        return twice > need ? twice : need;
    }

    // Allocate + fill a fresh block from a known-size input; sets p_.
    void init_default(size_type n) {
        void* np = detail::lean_arr_alloc_block(ops(), n);
        T* d = static_cast<T*>(np);
        for (size_type i = 0; i < n; ++i)
            ::new (static_cast<void*>(d + i)) T();
        detail::lean_used(np) = n;
        p_ = np;
    }

    void init_value(size_type n, const T& x) {
        void* np = detail::lean_arr_alloc_block(ops(), n);
        T* d = static_cast<T*>(np);
        for (size_type i = 0; i < n; ++i)
            ::new (static_cast<void*>(d + i)) T(x);
        detail::lean_used(np) = n;
        p_ = np;
    }

    template<class It>
    void init_forward(It first, It last) {
        size_type n = static_cast<size_type>(std::distance(first, last));
        if (n == 0)
            return;
        void* np = detail::lean_arr_alloc_block(ops(), n);
        T* d = static_cast<T*>(np);
        for (; first != last; ++first, (void)++d)
            ::new (static_cast<void*>(d)) T(*first);
        detail::lean_used(np) = n;
        p_ = np;
    }

public:
    // ----- Constructors / destructor ---------------------------------------

    vector() noexcept = default;

    explicit vector(const allocator_type&) noexcept {}

    explicit vector(size_type n) {
        if (n)
            init_default(n);
    }
    vector(size_type n, const allocator_type&) {
        if (n)
            init_default(n);
    }

    vector(size_type n, const value_type& x) {
        if (n)
            init_value(n, x);
    }
    vector(size_type n, const value_type& x, const allocator_type&) {
        if (n)
            init_value(n, x);
    }

    template<class InputIter>
        requires forward_iterator<InputIter> &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last) {
        init_forward(first, last);
    }
    template<class InputIter>
        requires forward_iterator<InputIter> &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last, const allocator_type&) {
        init_forward(first, last);
    }

    template<class InputIter>
        requires input_iterator<InputIter> && (!forward_iterator<InputIter>) &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last) {
        for (; first != last; ++first)
            emplace_back(*first);
    }
    template<class InputIter>
        requires input_iterator<InputIter> && (!forward_iterator<InputIter>) &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last, const allocator_type&) {
        for (; first != last; ++first)
            emplace_back(*first);
    }

    vector(initializer_list<value_type> il) {
        init_forward(il.begin(), il.end());
    }
    vector(initializer_list<value_type> il, const allocator_type&) {
        init_forward(il.begin(), il.end());
    }

    vector(const vector& x) {
        static_assert(is_copy_constructible_v<T>,
            "vector copy requires a copy-constructible element type");
        detail::lean_arr_assign_copy(&p_, ops(), x.p_, x.size());
    }
    vector(const vector& x, const type_identity_t<allocator_type>&) {
        static_assert(is_copy_constructible_v<T>,
            "vector copy requires a copy-constructible element type");
        detail::lean_arr_assign_copy(&p_, ops(), x.p_, x.size());
    }

    vector(vector&& x) noexcept : p_(x.p_) { x.p_ = nullptr; }
    vector(vector&& x, const type_identity_t<allocator_type>&) noexcept : p_(x.p_) {
        x.p_ = nullptr;
    }

    ~vector() { reset(); }

    // ----- Assignment ------------------------------------------------------

    vector& operator=(const vector& x) {
        static_assert(is_copy_constructible_v<T>,
            "vector copy requires a copy-constructible element type");
        if (this != &x)
            detail::lean_arr_assign_copy(&p_, ops(), x.p_, x.size());
        return *this;
    }

    vector& operator=(vector&& x) noexcept {
        if (this != &x) {
            reset();
            p_ = x.p_;
            x.p_ = nullptr;
        }
        return *this;
    }

    vector& operator=(initializer_list<value_type> il) {
        assign(il.begin(), il.end());
        return *this;
    }

    void assign(size_type n, const value_type& x) {
        value_type val(x);                 // copy first: x may alias *this
        clear();
        if (n) {
            if (n > capacity())
                detail::lean_arr_reserve(&p_, ops(), n);
            T* d = static_cast<T*>(p_);
            for (size_type i = 0; i < n; ++i)
                ::new (static_cast<void*>(d + i)) T(val);
            set_size(n);
        }
    }

    template<class InputIter>
        requires forward_iterator<InputIter> &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    void assign(InputIter first, InputIter last) {
        size_type n = static_cast<size_type>(std::distance(first, last));
        clear();
        if (n) {
            if (n > capacity())
                detail::lean_arr_reserve(&p_, ops(), n);
            T* d = static_cast<T*>(p_);
            for (; first != last; ++first, (void)++d)
                ::new (static_cast<void*>(d)) T(*first);
            set_size(n);
        }
    }

    template<class InputIter>
        requires input_iterator<InputIter> && (!forward_iterator<InputIter>) &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    void assign(InputIter first, InputIter last) {
        clear();
        for (; first != last; ++first)
            emplace_back(*first);
    }

    void assign(initializer_list<value_type> il) {
        assign(il.begin(), il.end());
    }

    [[nodiscard]] allocator_type get_allocator() const noexcept { return allocator_type(); }

    // ----- Iterators -------------------------------------------------------

    [[nodiscard]] iterator               begin()        noexcept { return data(); }
    [[nodiscard]] const_iterator         begin()  const noexcept { return data(); }
    [[nodiscard]] iterator               end()          noexcept { return data() + size(); }
    [[nodiscard]] const_iterator         end()    const noexcept { return data() + size(); }
    [[nodiscard]] reverse_iterator       rbegin()       noexcept { return reverse_iterator(end()); }
    [[nodiscard]] const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    [[nodiscard]] reverse_iterator       rend()         noexcept { return reverse_iterator(begin()); }
    [[nodiscard]] const_reverse_iterator rend()   const noexcept { return const_reverse_iterator(begin()); }
    [[nodiscard]] const_iterator         cbegin() const noexcept { return begin(); }
    [[nodiscard]] const_iterator         cend()   const noexcept { return end(); }
    [[nodiscard]] const_reverse_iterator crbegin()const noexcept { return rbegin(); }
    [[nodiscard]] const_reverse_iterator crend()  const noexcept { return rend(); }

    // ----- Capacity --------------------------------------------------------

    [[nodiscard]] size_type size() const noexcept {
        return p_ ? detail::lean_used(p_) : 0;
    }
    [[nodiscard]] size_type capacity() const noexcept {
        return p_ ? detail::lean_capacity_bytes(p_, alignof(T)) / sizeof(T) : 0;
    }
    [[nodiscard]] bool empty() const noexcept { return size() == 0; }

    [[nodiscard]] size_type max_size() const noexcept {
        const size_type a = size_type(-1) / sizeof(T);
        const size_type d = static_cast<size_type>(numeric_limits<difference_type>::max());
        return a < d ? a : d;
    }

    void reserve(size_type n) {
        if (n > capacity()) {
            if (n > max_size())
                __builtin_trap();       // would be length_error
            detail::lean_arr_reserve(&p_, ops(), n);
        }
    }

    void shrink_to_fit() noexcept {
        detail::lean_arr_shrink(&p_, ops());
    }

    // ----- Element access --------------------------------------------------

    [[nodiscard]] reference       operator[](size_type n)       noexcept { return data()[n]; }
    [[nodiscard]] const_reference operator[](size_type n) const noexcept { return data()[n]; }

    [[nodiscard]] reference at(size_type n) {
        if (n >= size())
            __builtin_trap();           // would be out_of_range
        return data()[n];
    }
    [[nodiscard]] const_reference at(size_type n) const {
        if (n >= size())
            __builtin_trap();           // would be out_of_range
        return data()[n];
    }

    [[nodiscard]] reference       front()       noexcept { return data()[0]; }
    [[nodiscard]] const_reference front() const noexcept { return data()[0]; }
    [[nodiscard]] reference       back()        noexcept { return data()[size() - 1]; }
    [[nodiscard]] const_reference back()  const noexcept { return data()[size() - 1]; }

    [[nodiscard]] value_type*       data()       noexcept { return static_cast<value_type*>(p_); }
    [[nodiscard]] const value_type* data() const noexcept {
        return static_cast<const value_type*>(p_);
    }

    // ----- Modifiers -------------------------------------------------------

    void push_back(const value_type& x) { emplace_back(x); }
    void push_back(value_type&& x)       { emplace_back(std::move(x)); }

    template<class... Args>
    reference emplace_back(Args&&... args) {
        size_type sz = size();
        if (sz < capacity()) {
            // Fast path: one capacity compare + placement new.
            ::new (static_cast<void*>(data() + sz)) T(std::forward<Args>(args)...);
            set_size(sz + 1);
        } else {
            // Slow path: fresh block, construct the new element while the old
            // block is still alive (so v.push_back(v[0]) reads a live element),
            // then relocate the old elements around it and free the old block.
            void* np = detail::lean_arr_alloc_block(ops(), recommend(sz + 1));
            ::new (static_cast<void*>(static_cast<T*>(np) + sz)) T(std::forward<Args>(args)...);
            detail::lean_arr_commit_gap(&p_, ops(), np, sz, 1, sz);
        }
        return data()[size() - 1];
    }

    void pop_back() noexcept {
        size_type sz = size();
        detail::lean_arr_destroy(p_, ops(), sz - 1, sz);
        set_size(sz - 1);
    }

    template<class... Args>
    iterator emplace(const_iterator position, Args&&... args) {
        size_type idx = static_cast<size_type>(position - cbegin());
        size_type sz  = size();
        if (sz < capacity()) {
            if (idx == sz) {
                ::new (static_cast<void*>(data() + sz)) T(std::forward<Args>(args)...);
                set_size(sz + 1);
            } else {
                // Materialize first: args may reference an element inside the
                // shifted region (self-referential insert must work).
                value_type tmp(std::forward<Args>(args)...);
                detail::lean_arr_open_gap(p_, ops(), idx, 1);
                ::new (static_cast<void*>(data() + idx)) T(std::move(tmp));
            }
        } else {
            void* np = detail::lean_arr_alloc_block(ops(), recommend(sz + 1));
            ::new (static_cast<void*>(static_cast<T*>(np) + idx)) T(std::forward<Args>(args)...);
            detail::lean_arr_commit_gap(&p_, ops(), np, idx, 1, sz);
        }
        return data() + idx;
    }

    iterator insert(const_iterator position, const value_type& x) {
        return emplace(position, x);
    }
    iterator insert(const_iterator position, value_type&& x) {
        return emplace(position, std::move(x));
    }

    iterator insert(const_iterator position, size_type n, const value_type& x) {
        size_type idx = static_cast<size_type>(position - cbegin());
        size_type sz  = size();
        if (n) {
            value_type val(x);           // copy first: x may alias *this
            if (capacity() - sz >= n) {
                detail::lean_arr_open_gap(p_, ops(), idx, n);
                T* g = data() + idx;
                for (size_type i = 0; i < n; ++i)
                    ::new (static_cast<void*>(g + i)) T(val);
            } else {
                void* np = detail::lean_arr_alloc_block(ops(), recommend(sz + n));
                T* g = static_cast<T*>(np) + idx;
                for (size_type i = 0; i < n; ++i)
                    ::new (static_cast<void*>(g + i)) T(val);
                detail::lean_arr_commit_gap(&p_, ops(), np, idx, n, sz);
            }
        }
        return data() + idx;
    }

    // Range insert (forward iterators): the gap is filled from `first..last`
    // BEFORE the old block is freed, so inserting a sub-range of *this at end()
    // (the natural self-range case) reads live elements.
    template<class InputIter>
        requires forward_iterator<InputIter> &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    iterator insert(const_iterator position, InputIter first, InputIter last) {
        size_type idx = static_cast<size_type>(position - cbegin());
        size_type sz  = size();
        size_type n   = static_cast<size_type>(std::distance(first, last));
        if (n) {
            // In-place open_gap shifts [idx, sz) up by n BEFORE we read the
            // source. If the source range overlaps the shifted region
            // [idx, sz) of *this (a precondition violation per [sequence.reqmts],
            // but we must not silently corrupt), those source elements would be
            // read after being moved. Detect that and take the spill path
            // instead: it fills the new block from the still-live old block, so
            // any self-overlap reads pre-insert values correctly.
            bool src_overlaps = false;
            using Ref = typename iterator_traits<InputIter>::reference;
            if constexpr (is_lvalue_reference_v<Ref> &&
                          is_same_v<remove_cv_t<remove_reference_t<Ref>>, value_type>) {
                if (sz != 0) {
                    using uptr = __UINTPTR_TYPE__;
                    uptr s0 = reinterpret_cast<uptr>(std::addressof(*first));
                    uptr se = s0 + static_cast<uptr>(n) * sizeof(value_type);
                    uptr rs = reinterpret_cast<uptr>(data() + idx);
                    uptr re = reinterpret_cast<uptr>(data() + sz);
                    src_overlaps = s0 < re && rs < se;   // overlaps shifted region
                }
            }
            if (capacity() - sz >= n && !src_overlaps) {
                detail::lean_arr_open_gap(p_, ops(), idx, n);
                T* g = data() + idx;
                for (; first != last; ++first, (void)++g)
                    ::new (static_cast<void*>(g)) T(*first);
            } else {
                void* np = detail::lean_arr_alloc_block(ops(), recommend(sz + n));
                T* g = static_cast<T*>(np) + idx;
                for (; first != last; ++first, (void)++g)
                    ::new (static_cast<void*>(g)) T(*first);
                detail::lean_arr_commit_gap(&p_, ops(), np, idx, n, sz);
            }
        }
        return data() + idx;
    }

    // Range insert (input-only iterators): buffer into a temp, then bulk-insert.
    template<class InputIter>
        requires input_iterator<InputIter> && (!forward_iterator<InputIter>) &&
                 is_constructible_v<value_type, typename iterator_traits<InputIter>::reference>
    iterator insert(const_iterator position, InputIter first, InputIter last) {
        size_type idx = static_cast<size_type>(position - cbegin());
        vector tmp;
        for (; first != last; ++first)
            tmp.emplace_back(*first);
        return insert(cbegin() + idx, tmp.begin(), tmp.end());
    }

    iterator insert(const_iterator position, initializer_list<value_type> il) {
        return insert(position, il.begin(), il.end());
    }

    iterator erase(const_iterator position) {
        size_type idx = static_cast<size_type>(position - cbegin());
        detail::lean_arr_erase(&p_, ops(), idx, 1);
        return data() + idx;
    }

    iterator erase(const_iterator first, const_iterator last) {
        size_type idx   = static_cast<size_type>(first - cbegin());
        size_type count = static_cast<size_type>(last - first);
        detail::lean_arr_erase(&p_, ops(), idx, count);
        return data() + idx;
    }

    void clear() noexcept {
        if (p_) {
            detail::lean_arr_destroy(p_, ops(), 0, detail::lean_used(p_));
            set_size(0);
        }
    }

    void resize(size_type sz) {
        size_type cur = size();
        if (sz < cur) {
            detail::lean_arr_destroy(p_, ops(), sz, cur);
            set_size(sz);
        } else if (sz > cur) {
            if (sz > capacity())
                detail::lean_arr_reserve(&p_, ops(), recommend(sz));
            T* d = static_cast<T*>(p_);
            for (size_type i = cur; i < sz; ++i)
                ::new (static_cast<void*>(d + i)) T();
            set_size(sz);
        }
    }

    void resize(size_type sz, const value_type& x) {
        size_type cur = size();
        if (sz < cur) {
            detail::lean_arr_destroy(p_, ops(), sz, cur);
            set_size(sz);
        } else if (sz > cur) {
            if (sz > capacity()) {
                value_type val(x);       // copy first: x may alias *this
                detail::lean_arr_reserve(&p_, ops(), recommend(sz));
                T* d = static_cast<T*>(p_);
                for (size_type i = cur; i < sz; ++i)
                    ::new (static_cast<void*>(d + i)) T(val);
            } else {
                // No reallocation: x stays valid (appended cells don't move it).
                T* d = static_cast<T*>(p_);
                for (size_type i = cur; i < sz; ++i)
                    ::new (static_cast<void*>(d + i)) T(x);
            }
            set_size(sz);
        }
    }

    void swap(vector& x) noexcept {
        void* t = p_;
        p_ = x.p_;
        x.p_ = t;
    }
};

//===----------------------------------------------------------------------===//
// Deduction guides
//===----------------------------------------------------------------------===//

template<class InputIter,
         class Alloc = allocator<typename iterator_traits<InputIter>::value_type>>
    requires input_iterator<InputIter>
vector(InputIter, InputIter) -> vector<typename iterator_traits<InputIter>::value_type, Alloc>;

template<class InputIter, class Alloc>
    requires input_iterator<InputIter> &&
             requires(Alloc a) { typename Alloc::value_type; a.allocate(size_t{}); }
vector(InputIter, InputIter, Alloc) -> vector<typename iterator_traits<InputIter>::value_type, Alloc>;

//===----------------------------------------------------------------------===//
// vector<bool, Allocator> — one-pointer bit block (proxy-reference minimum).
//===----------------------------------------------------------------------===//

template<class Allocator>
class vector<bool, Allocator> {
    static_assert(detail::lean_allocator_ok<bool, Allocator>,
        "lean vector<bool> supports only std::allocator<bool>");

    using word = size_t;                         // storage word

public:
    using value_type      = bool;
    using allocator_type  = Allocator;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;

private:
    static constexpr size_type bpw = sizeof(word) * CHAR_BIT;   // bits per word

    void* p_ = nullptr;                          // lean block of words; used = bits

    static const detail::lean_ops* ops() noexcept { return &detail::lean_ops_for<word>; }
    word* words() const noexcept { return static_cast<word*>(const_cast<void*>(p_)); }

    static size_type word_count(size_type bits) noexcept { return (bits + bpw - 1) / bpw; }

    size_type recommend(size_type bits) const {
        size_type c = capacity();
        size_type twice = 2 * c;
        size_type aligned = word_count(bits) * bpw;
        return twice > aligned ? twice : aligned;
    }

public:
    // Proxy reference to a single bit.
    class reference {
        word* seg_;
        word  mask_;
        friend class vector;
        reference(word* s, word m) noexcept : seg_(s), mask_(m) {}
    public:
        reference(const reference&) = default;
        operator bool() const noexcept { return (*seg_ & mask_) != 0; }
        bool operator~() const noexcept { return (*seg_ & mask_) == 0; }
        reference& operator=(bool x) noexcept {
            if (x) *seg_ |= mask_; else *seg_ &= ~mask_;
            return *this;
        }
        reference& operator=(const reference& r) noexcept { return *this = bool(r); }
        void flip() noexcept { *seg_ ^= mask_; }
    };
    using const_reference = bool;

    // Random-access bit iterator (shared const/non-const via IsConst).
    template<bool IsConst>
    class bit_iter {
        word*    seg_ = nullptr;
        unsigned ctz_ = 0;
        friend class vector;
        friend class bit_iter<!IsConst>;
        bit_iter(word* s, unsigned c) noexcept : seg_(s), ctz_(c) {}
    public:
        using value_type        = bool;
        using reference         = conditional_t<IsConst, bool, vector::reference>;
        using pointer           = void;
        using difference_type   = ptrdiff_t;
        using iterator_category = random_access_iterator_tag;
        using iterator_concept  = random_access_iterator_tag;

        bit_iter() noexcept = default;
        // non-const -> const conversion
        template<bool IC = IsConst, class = enable_if_t<IC>>
        bit_iter(const bit_iter<false>& o) noexcept : seg_(o.seg_), ctz_(o.ctz_) {}

        reference operator*() const noexcept {
            if constexpr (IsConst)
                return (*seg_ & (word(1) << ctz_)) != 0;
            else
                return vector::reference(seg_, word(1) << ctz_);
        }

        bit_iter& operator++() noexcept {
            if (ctz_ != bpw - 1) ++ctz_;
            else { ctz_ = 0; ++seg_; }
            return *this;
        }
        bit_iter operator++(int) noexcept { bit_iter t = *this; ++*this; return t; }
        bit_iter& operator--() noexcept {
            if (ctz_ != 0) --ctz_;
            else { ctz_ = static_cast<unsigned>(bpw - 1); --seg_; }
            return *this;
        }
        bit_iter operator--(int) noexcept { bit_iter t = *this; --*this; return t; }

        bit_iter& operator+=(difference_type n) noexcept {
            if (n >= 0)
                seg_ += (n + ctz_) / difference_type(bpw);
            else
                seg_ += static_cast<difference_type>(n - difference_type(bpw) + ctz_ + 1)
                        / difference_type(bpw);
            n &= (difference_type(bpw) - 1);
            ctz_ = static_cast<unsigned>((n + ctz_) % difference_type(bpw));
            return *this;
        }
        bit_iter& operator-=(difference_type n) noexcept { return *this += -n; }
        bit_iter operator+(difference_type n) const noexcept { bit_iter t = *this; t += n; return t; }
        bit_iter operator-(difference_type n) const noexcept { bit_iter t = *this; t -= n; return t; }
        friend bit_iter operator+(difference_type n, const bit_iter& it) noexcept { return it + n; }
        friend difference_type operator-(const bit_iter& a, const bit_iter& b) noexcept {
            return (a.seg_ - b.seg_) * difference_type(bpw)
                   + difference_type(a.ctz_) - difference_type(b.ctz_);
        }
        reference operator[](difference_type n) const noexcept { return *(*this + n); }

        friend bool operator==(const bit_iter& a, const bit_iter& b) noexcept {
            return a.seg_ == b.seg_ && a.ctz_ == b.ctz_;
        }
        friend strong_ordering operator<=>(const bit_iter& a, const bit_iter& b) noexcept {
            if (a.seg_ != b.seg_) return a.seg_ <=> b.seg_;
            return a.ctz_ <=> b.ctz_;
        }
    };

    using iterator               = bit_iter<false>;
    using const_iterator         = bit_iter<true>;
    using pointer                = iterator;
    using const_pointer          = const_iterator;
    using reverse_iterator       = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;

private:
    void reset() noexcept {
        if (p_) {
            detail::lean_free(p_, alignof(word));
            p_ = nullptr;
        }
    }

public:
    vector() noexcept = default;
    explicit vector(const allocator_type&) noexcept {}

    explicit vector(size_type n) {
        if (n) { reserve(n); detail::lean_used(p_) = n; fill_range(0, n, false); }
    }
    vector(size_type n, const value_type& x) {
        if (n) { reserve(n); detail::lean_used(p_) = n; fill_range(0, n, x); }
    }
    vector(size_type n, const value_type& x, const allocator_type&) {
        if (n) { reserve(n); detail::lean_used(p_) = n; fill_range(0, n, x); }
    }

    template<class InputIter>
        requires input_iterator<InputIter> &&
                 is_constructible_v<bool, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last) {
        for (; first != last; ++first)
            push_back(*first);
    }
    template<class InputIter>
        requires input_iterator<InputIter> &&
                 is_constructible_v<bool, typename iterator_traits<InputIter>::reference>
    vector(InputIter first, InputIter last, const allocator_type&) {
        for (; first != last; ++first)
            push_back(*first);
    }

    vector(initializer_list<value_type> il) {
        for (bool b : il)
            push_back(b);
    }

    vector(const vector& v) {
        size_type n = v.size();
        if (n) {
            reserve(n);
            detail::lean_used(p_) = n;
            size_type nw = word_count(n);
            for (size_type i = 0; i < nw; ++i)
                words()[i] = v.words()[i];
        }
    }

    vector(vector&& v) noexcept : p_(v.p_) { v.p_ = nullptr; }

    ~vector() { reset(); }

    vector& operator=(const vector& v) {
        if (this != &v)
            assign(v.begin(), v.end());
        return *this;
    }
    vector& operator=(vector&& v) noexcept {
        if (this != &v) { reset(); p_ = v.p_; v.p_ = nullptr; }
        return *this;
    }
    vector& operator=(initializer_list<value_type> il) {
        assign(il.begin(), il.end());
        return *this;
    }

    void assign(size_type n, const value_type& x) {
        if (p_) detail::lean_used(p_) = 0;
        if (n) { reserve(n); detail::lean_used(p_) = n; fill_range(0, n, x); }
    }
    template<class InputIter>
        requires input_iterator<InputIter> &&
                 is_constructible_v<bool, typename iterator_traits<InputIter>::reference>
    void assign(InputIter first, InputIter last) {
        if (p_) detail::lean_used(p_) = 0;
        for (; first != last; ++first)
            push_back(*first);
    }
    void assign(initializer_list<value_type> il) { assign(il.begin(), il.end()); }

    [[nodiscard]] allocator_type get_allocator() const noexcept { return allocator_type(); }

    // Iterators
    [[nodiscard]] iterator       begin()        noexcept { return iterator(words(), 0); }
    [[nodiscard]] const_iterator begin()  const noexcept { return const_iterator(words(), 0); }
    [[nodiscard]] iterator       end()          noexcept { return make_end<iterator>(); }
    [[nodiscard]] const_iterator end()    const noexcept { return make_end<const_iterator>(); }
    [[nodiscard]] reverse_iterator       rbegin()       noexcept { return reverse_iterator(end()); }
    [[nodiscard]] const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    [[nodiscard]] reverse_iterator       rend()         noexcept { return reverse_iterator(begin()); }
    [[nodiscard]] const_reverse_iterator rend()   const noexcept { return const_reverse_iterator(begin()); }
    [[nodiscard]] const_iterator cbegin() const noexcept { return begin(); }
    [[nodiscard]] const_iterator cend()   const noexcept { return end(); }
    [[nodiscard]] const_reverse_iterator crbegin() const noexcept { return rbegin(); }
    [[nodiscard]] const_reverse_iterator crend()   const noexcept { return rend(); }

    // Capacity
    [[nodiscard]] size_type size()  const noexcept { return p_ ? detail::lean_used(p_) : 0; }
    [[nodiscard]] bool      empty() const noexcept { return size() == 0; }
    [[nodiscard]] size_type capacity() const noexcept {
        return p_ ? detail::lean_arr_capacity(p_, ops()) * bpw : 0;
    }
    [[nodiscard]] size_type max_size() const noexcept {
        return static_cast<size_type>(numeric_limits<difference_type>::max());
    }

    void reserve(size_type n) {
        if (n > capacity()) {
            if (n > max_size())
                __builtin_trap();
            size_type oldw = p_ ? detail::lean_arr_capacity(p_, ops()) : 0;
            detail::lean_arr_reserve(&p_, ops(), word_count(n));
            // Zero the freshly-grown words so bit RMW (*seg &= ~mask) never
            // reads indeterminate storage; only bits < size are ever read.
            size_type neww = detail::lean_arr_capacity(p_, ops());
            for (size_type i = oldw; i < neww; ++i)
                words()[i] = 0;
        }
    }

    void shrink_to_fit() noexcept {
        if (!p_) return;
        size_type sz = size();
        if (sz == 0) { reset(); return; }
        size_type nw = word_count(sz);
        if (nw < detail::lean_arr_capacity(p_, ops())) {
            void* np = detail::lean_realloc(p_, alignof(word), nw * sizeof(word));
            detail::lean_used(np) = sz;
            p_ = np;
        }
    }

    // Element access
    [[nodiscard]] reference       operator[](size_type n)       noexcept { return make_ref(n); }
    [[nodiscard]] const_reference operator[](size_type n) const noexcept { return get_bit(n); }
    [[nodiscard]] reference at(size_type n) {
        if (n >= size()) __builtin_trap();
        return make_ref(n);
    }
    [[nodiscard]] const_reference at(size_type n) const {
        if (n >= size()) __builtin_trap();
        return get_bit(n);
    }
    [[nodiscard]] reference       front()       noexcept { return make_ref(0); }
    [[nodiscard]] const_reference front() const noexcept { return get_bit(0); }
    [[nodiscard]] reference       back()        noexcept { return make_ref(size() - 1); }
    [[nodiscard]] const_reference back()  const noexcept { return get_bit(size() - 1); }

    // Modifiers
    void push_back(const value_type& x) {
        size_type sz = size();
        if (sz == capacity())
            reserve(recommend(sz + 1));
        detail::lean_used(p_) = sz + 1;
        make_ref(sz) = x;
    }
    template<class... Args>
    reference emplace_back(Args&&... args) {
        push_back(value_type(std::forward<Args>(args)...));
        return back();
    }
    void pop_back() noexcept { detail::lean_used(p_) = size() - 1; }
    void clear() noexcept { if (p_) detail::lean_used(p_) = 0; }

    void resize(size_type sz, value_type x = false) {
        size_type cur = size();
        if (sz < cur) { detail::lean_used(p_) = sz; return; }
        if (sz > cur) {
            reserve(sz);
            detail::lean_used(p_) = sz;
            fill_range(cur, sz, x);
        }
    }

    void flip() noexcept {
        size_type nw = word_count(size());
        for (size_type i = 0; i < nw; ++i)
            words()[i] = ~words()[i];
    }

    void swap(vector& v) noexcept { void* t = p_; p_ = v.p_; v.p_ = t; }
    static void swap(reference x, reference y) noexcept { bool t = x; x = y; y = t; }

private:
    reference make_ref(size_type n) const noexcept {
        return reference(words() + n / bpw, word(1) << (n % bpw));
    }
    bool get_bit(size_type n) const noexcept {
        return (words()[n / bpw] & (word(1) << (n % bpw))) != 0;
    }
    void fill_range(size_type first, size_type last, bool x) noexcept {
        for (size_type i = first; i < last; ++i)
            make_ref(i) = x;
    }
    template<class It>
    It make_end() const noexcept {
        size_type sz = size();
        return It(words() + sz / bpw, static_cast<unsigned>(sz % bpw));
    }
};

//===----------------------------------------------------------------------===//
// Non-member operators / swap / erase (cover both vector<T> and vector<bool>)
//===----------------------------------------------------------------------===//

template<class T, class Alloc>
bool operator==(const vector<T, Alloc>& x, const vector<T, Alloc>& y) {
    return x.size() == y.size() && std::equal(x.begin(), x.end(), y.begin());
}

template<class T, class Alloc>
detail::synth_three_way_result<T>
operator<=>(const vector<T, Alloc>& x, const vector<T, Alloc>& y) {
    return std::lexicographical_compare_three_way(
        x.begin(), x.end(), y.begin(), y.end(), detail::synth_three_way);
}

template<class T, class Alloc>
void swap(vector<T, Alloc>& x, vector<T, Alloc>& y) noexcept(noexcept(x.swap(y))) {
    x.swap(y);
}

template<class T, class Alloc, class U>
typename vector<T, Alloc>::size_type
erase(vector<T, Alloc>& c, const U& value) {
    auto old = c.size();
    c.erase(std::remove(c.begin(), c.end(), value), c.end());
    return old - c.size();
}

template<class T, class Alloc, class Predicate>
typename vector<T, Alloc>::size_type
erase_if(vector<T, Alloc>& c, Predicate pred) {
    auto old = c.size();
    c.erase(std::remove_if(c.begin(), c.end(), pred), c.end());
    return old - c.size();
}

} // namespace std
