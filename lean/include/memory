// <memory> — mechanically ported from libc++ include/memory + include/__memory/*.h
// Target: gcc-10.2, -std=gnu++20 -fno-exceptions -fno-rtti
//
// All __memory/*.h fragments are folded inline.
// Depends on: <type_traits>, <utility>, <iterator>, <new>, <bits/pointer.h>
// <compare> (for operator<=>), <functional> (for hash specialisations)
//
// Over-allocation handling: where libc++ would throw bad_alloc or
// length_error (allocator::allocate exceeds max_size), we call
// __builtin_trap() instead since exceptions are disabled.
#pragma once

#include <type_traits>
#include <utility>
#include <iterator>
#include <new>
#include <bits/pointer.h>
#include <bits/construct_at.h>
#include <compare>
#include <cstdint>  // uintptr_t
#include <atomic>   // memory_order (for the [util.smartptr.shared.atomic] API)
#include <iosfwd>   // basic_ostream forward declaration (for operator<<)
// <functional> is included here (before namespace std) so that <tuple>'s
// uses_allocator definition (pulled in transitively) is authoritative.
// <memory> itself does NOT redefine uses_allocator — it reuses the one
// from <tuple> (ODR rule: one definition only).
#include <functional>

namespace std {

//===----------------------------------------------------------------------===//
// Re-export from <bits/pointer.h>
// addressof, pointer_traits, to_address are already in std:: from
// <bits/pointer.h>.  They are NOT redefined here (ODR rule).
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// allocation_result (C++23) / allocate_at_least
// (from __memory/allocate_at_least.h, __memory/allocator_traits.h)
//===----------------------------------------------------------------------===//

template<class Pointer, class SizeType = size_t>
struct allocation_result {
    Pointer ptr;
    SizeType count;
};

//===----------------------------------------------------------------------===//
// allocator_arg_t / allocator_arg
// (from __memory/allocator_arg_t.h)
//===----------------------------------------------------------------------===//

struct allocator_arg_t {
    explicit allocator_arg_t() = default;
};

inline constexpr allocator_arg_t allocator_arg{};

// uses_allocator / uses_allocator_v
// The primary template is defined in <tuple> (included transitively via
// <functional> above). That primary always returns false_type. Here we add
// the standard-mandated partial specialization for types that have a nested
// allocator_type that the Alloc is convertible to. Adding a specialization to
// an existing primary template is NOT an ODR violation.
namespace detail {
    template<class T, class Alloc, class = void>
    inline constexpr bool uses_allocator_impl_v = false;
    template<class T, class Alloc>
    inline constexpr bool uses_allocator_impl_v<T, Alloc,
        void_t<typename T::allocator_type>>
        = is_convertible_v<Alloc, typename T::allocator_type>;
}

// Partial specialisation: true when T has allocator_type convertible from Alloc.
template<class T, class Alloc>
    requires (detail::uses_allocator_impl_v<T, Alloc> &&
              !is_same_v<T, tuple<>>)  // avoid ambiguity with tuple<> specialisation
struct uses_allocator<T, Alloc> : true_type {};

//===----------------------------------------------------------------------===//
// [allocator.uses.construction]  uses_allocator_construction_args /
// make_obj_using_allocator / uninitialized_construct_using_allocator (C++20)
// (from __memory/uses_allocator_construction.h, C++20 subset)
//===----------------------------------------------------------------------===//

namespace detail {

template<class T>
inline constexpr bool is_std_pair = false;
template<class T1, class T2>
inline constexpr bool is_std_pair<pair<T1, T2>> = true;
template<class T>
inline constexpr bool is_cv_std_pair = is_std_pair<remove_cv_t<T>>;

template<class T, class = void>
struct uses_alloc_args;

namespace uses_alloc_detail {
    template<class A, class B>
    void pair_ref_fun(const pair<A, B>&);

    template<class T>
    decltype(uses_alloc_detail::pair_ref_fun(declval<T>()), true_type())
    convertible_to_const_pair_ref_impl(int);
    template<class>
    false_type convertible_to_const_pair_ref_impl(...);

    template<class T>
    inline constexpr bool convertible_to_const_pair_ref =
        decltype(uses_alloc_detail::convertible_to_const_pair_ref_impl<T>(0))::value;

    template<class T, class U>
    inline constexpr bool uses_allocator_constraints =
        is_cv_std_pair<T> && !convertible_to_const_pair_ref<U>;
} // namespace uses_alloc_detail

template<class Type, class Alloc, class... Args>
constexpr Type make_obj_using_allocator_impl(const Alloc& alloc, Args&&... args);

template<class Pair>
struct uses_alloc_args<Pair, enable_if_t<is_cv_std_pair<Pair>>> {
    template<class Alloc, class Tuple1, class Tuple2>
    static constexpr auto
    apply(const Alloc& alloc, piecewise_construct_t, Tuple1&& x, Tuple2&& y) noexcept {
        return std::make_tuple(
            piecewise_construct,
            std::apply(
                [&alloc](auto&&... args1) {
                    return uses_alloc_args<typename Pair::first_type>::apply(
                        alloc, std::forward<decltype(args1)>(args1)...);
                },
                std::forward<Tuple1>(x)),
            std::apply(
                [&alloc](auto&&... args2) {
                    return uses_alloc_args<typename Pair::second_type>::apply(
                        alloc, std::forward<decltype(args2)>(args2)...);
                },
                std::forward<Tuple2>(y)));
    }

    template<class Alloc>
    static constexpr auto apply(const Alloc& alloc) noexcept {
        return uses_alloc_args<Pair>::apply(alloc, piecewise_construct, tuple<>{}, tuple<>{});
    }

    template<class Alloc, class U, class V>
    static constexpr auto apply(const Alloc& alloc, U&& u, V&& v) noexcept {
        return uses_alloc_args<Pair>::apply(
            alloc, piecewise_construct,
            std::forward_as_tuple(std::forward<U>(u)),
            std::forward_as_tuple(std::forward<V>(v)));
    }

    template<class Alloc, class U, class V>
    static constexpr auto apply(const Alloc& alloc, const pair<U, V>& p) noexcept {
        return uses_alloc_args<Pair>::apply(
            alloc, piecewise_construct,
            std::forward_as_tuple(p.first), std::forward_as_tuple(p.second));
    }

    template<class Alloc, class U, class V>
    static constexpr auto apply(const Alloc& alloc, pair<U, V>&& p) noexcept {
        return uses_alloc_args<Pair>::apply(
            alloc, piecewise_construct,
            std::forward_as_tuple(std::get<0>(std::move(p))),
            std::forward_as_tuple(std::get<1>(std::move(p))));
    }

    // converting from a non-pair value that is convertible to the pair: defer
    // through a one-element tuple holding a converting proxy (libc++
    // __pair_constructor).
    template<class Alloc, class Type,
             enable_if_t<uses_alloc_detail::uses_allocator_constraints<Pair, Type>, int> = 0>
    static constexpr auto apply(const Alloc& alloc, Type&& value) noexcept {
        struct pair_constructor {
            using PairMutable = remove_cv_t<Pair>;

            constexpr auto do_construct(const PairMutable& p) const {
                return detail::make_obj_using_allocator_impl<PairMutable>(alloc_, p);
            }
            constexpr auto do_construct(PairMutable&& p) const {
                return detail::make_obj_using_allocator_impl<PairMutable>(alloc_, std::move(p));
            }

            const Alloc& alloc_;
            Type& value_;

            constexpr operator PairMutable() const {
                return do_construct(std::forward<Type>(value_));
            }
        };
        return std::make_tuple(pair_constructor{alloc, value});
    }
};

template<class Type>
struct uses_alloc_args<Type, enable_if_t<!is_cv_std_pair<Type>>> {
    template<class Alloc, class... Args>
    static constexpr auto apply(const Alloc& alloc, Args&&... args) noexcept {
        if constexpr (!uses_allocator_v<remove_cv_t<Type>, Alloc> &&
                      is_constructible_v<Type, Args...>) {
            return std::forward_as_tuple(std::forward<Args>(args)...);
        } else if constexpr (uses_allocator_v<remove_cv_t<Type>, Alloc> &&
                             is_constructible_v<Type, allocator_arg_t, const Alloc&, Args...>) {
            return tuple<allocator_arg_t, const Alloc&, Args&&...>(
                allocator_arg, alloc, std::forward<Args>(args)...);
        } else if constexpr (uses_allocator_v<remove_cv_t<Type>, Alloc> &&
                             is_constructible_v<Type, Args..., const Alloc&>) {
            return std::forward_as_tuple(std::forward<Args>(args)..., alloc);
        } else {
            static_assert(sizeof(Type) + 1 == 0,
                "If uses_allocator_v<Type> is true, the type has to be allocator-constructible");
        }
    }
};

template<class Type, class Alloc, class... Args>
constexpr Type make_obj_using_allocator_impl(const Alloc& alloc, Args&&... args) {
    return std::make_from_tuple<Type>(
        uses_alloc_args<Type>::apply(alloc, std::forward<Args>(args)...));
}

} // namespace detail

template<class Type, class Alloc, class... Args>
[[nodiscard]] constexpr auto
uses_allocator_construction_args(const Alloc& alloc, Args&&... args) noexcept
    -> decltype(detail::uses_alloc_args<Type>::apply(alloc, std::forward<Args>(args)...)) {
    return detail::uses_alloc_args<Type>::apply(alloc, std::forward<Args>(args)...);
}

template<class Type, class Alloc, class... Args>
[[nodiscard]] constexpr auto
make_obj_using_allocator(const Alloc& alloc, Args&&... args)
    -> decltype(detail::make_obj_using_allocator_impl<Type>(alloc, std::forward<Args>(args)...)) {
    return detail::make_obj_using_allocator_impl<Type>(alloc, std::forward<Args>(args)...);
}

// plain auto return: gcc-10 rejects a lambda in a trailing decltype here
// ("use of parameter outside function body").
template<class Type, class Alloc, class... Args>
constexpr Type*
uninitialized_construct_using_allocator(Type* ptr, const Alloc& alloc, Args&&... args) {
    return std::apply(
        [&ptr](auto&&... xs) { return std::construct_at(ptr, std::forward<decltype(xs)>(xs)...); },
        detail::uses_alloc_args<Type>::apply(alloc, std::forward<Args>(args)...));
}

//===----------------------------------------------------------------------===//
// construct_at / destroy_at  (C++20)
// (from __memory/construct_at.h)
//===----------------------------------------------------------------------===//

// Definition lives in bits/construct_at.h (<optional> needs it; including
// <memory> there would cycle through bits/memory_ranges.h -> <ranges>).

// Internal helper (used by allocator_traits and uninitialized algorithms).
// MUST forward to std::construct_at, not repeat the placement new: gcc-10 only
// blesses constexpr placement new inside the function literally named
// std::construct_at, so a copy under any other name is non-constexpr.
namespace detail {
    template<class T, class... Args>
        requires requires { ::new(declval<void*>()) T(declval<Args>()...); }
    constexpr T* construct_at_impl(T* loc, Args&&... args) {
        return std::construct_at(loc, std::forward<Args>(args)...);
    }
}

template<class T>
constexpr void destroy_at(T* loc) {
    if constexpr (is_array_v<T>) {
        for (auto& elem : *loc)
            std::destroy_at(std::addressof(elem));  // qualified: no ADL over T's associated classes
    } else {
        loc->~T();
    }
}

//===----------------------------------------------------------------------===//
// destroy / destroy_n  (C++17)
// (from __memory/destroy.h)
//===----------------------------------------------------------------------===//

template<class ForwardIter>
constexpr void destroy(ForwardIter first, ForwardIter last) {
    for (; first != last; ++first)
        std::destroy_at(std::addressof(*first));  // qualified: no ADL
}

template<class ForwardIter, class Size>
constexpr ForwardIter destroy_n(ForwardIter first, Size n) {
    for (; n > 0; (void)++first, --n)
        std::destroy_at(std::addressof(*first));  // qualified: no ADL
    return first;
}

//===----------------------------------------------------------------------===//
// allocator_traits
// (from __memory/allocator_traits.h)
//===----------------------------------------------------------------------===//

// Forward-declare allocator<T>
template<class T>
class allocator;

// --- Detection helpers ---
namespace detail {

    // pointer member
    template<class Alloc, class = void>
    struct alloc_pointer { using type = typename Alloc::value_type*; };
    template<class Alloc>
    struct alloc_pointer<Alloc, void_t<typename Alloc::pointer>> { using type = typename Alloc::pointer; };

    // const_pointer
    template<class Alloc, class Ptr, class = void>
    struct alloc_const_pointer {
        using type = typename pointer_traits<Ptr>::template rebind<const typename Alloc::value_type>;
    };
    template<class Alloc, class Ptr>
    struct alloc_const_pointer<Alloc, Ptr, void_t<typename Alloc::const_pointer>> {
        using type = typename Alloc::const_pointer;
    };

    // void_pointer
    template<class Alloc, class Ptr, class = void>
    struct alloc_void_pointer {
        using type = typename pointer_traits<Ptr>::template rebind<void>;
    };
    template<class Alloc, class Ptr>
    struct alloc_void_pointer<Alloc, Ptr, void_t<typename Alloc::void_pointer>> {
        using type = typename Alloc::void_pointer;
    };

    // const_void_pointer
    template<class Alloc, class Ptr, class = void>
    struct alloc_const_void_pointer {
        using type = typename pointer_traits<Ptr>::template rebind<const void>;
    };
    template<class Alloc, class Ptr>
    struct alloc_const_void_pointer<Alloc, Ptr, void_t<typename Alloc::const_void_pointer>> {
        using type = typename Alloc::const_void_pointer;
    };

    // difference_type
    template<class Alloc, class Ptr, class = void>
    struct alloc_difference_type {
        using type = typename pointer_traits<Ptr>::difference_type;
    };
    template<class Alloc, class Ptr>
    struct alloc_difference_type<Alloc, Ptr, void_t<typename Alloc::difference_type>> {
        using type = typename Alloc::difference_type;
    };

    // size_type
    template<class Alloc, class Diff, class = void>
    struct alloc_size_type { using type = make_unsigned_t<Diff>; };
    template<class Alloc, class Diff>
    struct alloc_size_type<Alloc, Diff, void_t<typename Alloc::size_type>> {
        using type = typename Alloc::size_type;
    };

    // propagate_on_container_copy_assignment
    template<class Alloc, class = void>
    struct alloc_pocca { using type = false_type; };
    template<class Alloc>
    struct alloc_pocca<Alloc, void_t<typename Alloc::propagate_on_container_copy_assignment>> {
        using type = typename Alloc::propagate_on_container_copy_assignment;
    };

    // propagate_on_container_move_assignment
    template<class Alloc, class = void>
    struct alloc_pocma { using type = false_type; };
    template<class Alloc>
    struct alloc_pocma<Alloc, void_t<typename Alloc::propagate_on_container_move_assignment>> {
        using type = typename Alloc::propagate_on_container_move_assignment;
    };

    // propagate_on_container_swap
    template<class Alloc, class = void>
    struct alloc_pocs { using type = false_type; };
    template<class Alloc>
    struct alloc_pocs<Alloc, void_t<typename Alloc::propagate_on_container_swap>> {
        using type = typename Alloc::propagate_on_container_swap;
    };

    // is_always_equal
    template<class Alloc, class = void>
    struct alloc_iae { using type = typename is_empty<Alloc>::type; };
    template<class Alloc>
    struct alloc_iae<Alloc, void_t<typename Alloc::is_always_equal>> {
        using type = typename Alloc::is_always_equal;
    };

    // rebind_alloc.  Dispatch on a bool (libc++ __allocator_traits_rebind), NOT
    // two void_t partial specializations: for a class template that ALSO has a
    // member rebind, both would match at <Alloc, U, void> and the
    // template-template pattern wins partial ordering -- silently ignoring the
    // member rebind, which the standard gives priority.
    template<class Alloc, class U>
    inline constexpr bool has_rebind_other =
        requires { typename Alloc::template rebind<U>::other; };

    template<class Alloc, class U, bool = has_rebind_other<Alloc, U>>
    struct alloc_rebind_impl {
        using type = typename Alloc::template rebind<U>::other;
    };
    template<template<class, class...> class AllocTpl, class T, class... Args, class U>
    struct alloc_rebind_impl<AllocTpl<T, Args...>, U, true> {
        using type = typename AllocTpl<T, Args...>::template rebind<U>::other;
    };
    template<template<class, class...> class AllocTpl, class T, class... Args, class U>
    struct alloc_rebind_impl<AllocTpl<T, Args...>, U, false> {
        using type = AllocTpl<U, Args...>;
    };

    template<class Alloc, class U>
    using alloc_rebind_t = typename alloc_rebind_impl<Alloc, U>::type;

    // has_construct / has_destroy.  requires-expressions, not the void_t-slot
    // arrangement: a pack after a defaulted detection slot silently ate the
    // first real Args argument at the call site (has_alloc_construct<Alloc, T*,
    // Args...> put Args[0] in the void slot), so allocator construct() members
    // were never detected when args were passed.
    template<class Alloc, class Ptr, class... Args>
    inline constexpr bool has_alloc_construct =
        requires(Alloc& a, Ptr p) { a.construct(p, declval<Args>()...); };

    template<class Alloc, class Ptr>
    inline constexpr bool has_alloc_destroy =
        requires(Alloc& a, Ptr p) { a.destroy(p); };

    // has_max_size
    template<class Alloc, class = void>
    inline constexpr bool has_alloc_max_size = false;
    template<class Alloc>
    inline constexpr bool has_alloc_max_size<Alloc,
        void_t<decltype(declval<const Alloc&>().max_size())>> = true;

    // has_select_on_container_copy_construction
    template<class Alloc, class = void>
    inline constexpr bool has_alloc_soccc = false;
    template<class Alloc>
    inline constexpr bool has_alloc_soccc<Alloc,
        void_t<decltype(declval<const Alloc&>().select_on_container_copy_construction())>> = true;

    // has_allocate_hint
    template<class Alloc, class SizeType, class ConstVoidPtr, class = void>
    inline constexpr bool has_alloc_hint = false;
    template<class Alloc, class SizeType, class ConstVoidPtr>
    inline constexpr bool has_alloc_hint<Alloc, SizeType, ConstVoidPtr,
        void_t<decltype(declval<Alloc&>().allocate(declval<SizeType>(), declval<ConstVoidPtr>()))>> = true;

    // has_allocate_at_least (C++23)
    template<class Alloc, class = void>
    inline constexpr bool has_alloc_at_least = false;
    template<class Alloc>
    inline constexpr bool has_alloc_at_least<Alloc,
        void_t<decltype(declval<Alloc&>().allocate_at_least(declval<size_t>()))>> = true;

} // namespace detail

template<class Alloc>
struct allocator_traits {
    using allocator_type   = Alloc;
    using value_type       = typename Alloc::value_type;
    using pointer          = typename detail::alloc_pointer<Alloc>::type;
    using const_pointer    = typename detail::alloc_const_pointer<Alloc, pointer>::type;
    using void_pointer     = typename detail::alloc_void_pointer<Alloc, pointer>::type;
    using const_void_pointer = typename detail::alloc_const_void_pointer<Alloc, pointer>::type;
    using difference_type  = typename detail::alloc_difference_type<Alloc, pointer>::type;
    using size_type        = typename detail::alloc_size_type<Alloc, difference_type>::type;
    using propagate_on_container_copy_assignment = typename detail::alloc_pocca<Alloc>::type;
    using propagate_on_container_move_assignment = typename detail::alloc_pocma<Alloc>::type;
    using propagate_on_container_swap            = typename detail::alloc_pocs<Alloc>::type;
    using is_always_equal                        = typename detail::alloc_iae<Alloc>::type;

    template<class U>
    using rebind_alloc = detail::alloc_rebind_t<Alloc, U>;
    template<class U>
    using rebind_traits = allocator_traits<rebind_alloc<U>>;

    [[nodiscard]] static constexpr pointer
    allocate(Alloc& a, size_type n) {
        return a.allocate(n);
    }

    template<class Ap = Alloc>
        requires detail::has_alloc_hint<Ap, size_type, const_void_pointer>
    [[nodiscard]] static constexpr pointer
    allocate(Alloc& a, size_type n, const_void_pointer hint) {
        return a.allocate(n, hint);
    }

    template<class Ap = Alloc>
        requires (!detail::has_alloc_hint<Ap, size_type, const_void_pointer>)
    [[nodiscard]] static constexpr pointer
    allocate(Alloc& a, size_type n, const_void_pointer) {
        return a.allocate(n);
    }

    [[nodiscard]] static constexpr allocation_result<pointer, size_type>
    allocate_at_least(Alloc& a, size_type n) {
        if constexpr (detail::has_alloc_at_least<Alloc>) {
            auto res = a.allocate_at_least(n);
            return {res.ptr, res.count};
        } else {
            return {a.allocate(n), n};
        }
    }

    static constexpr void
    deallocate(Alloc& a, pointer p, size_type n) noexcept {
        a.deallocate(p, n);
    }

    template<class T, class... Args>
    static constexpr void
    construct(Alloc& a, T* p, Args&&... args) {
        if constexpr (detail::has_alloc_construct<Alloc, T*, Args...>) {
            a.construct(p, std::forward<Args>(args)...);
        } else {
            detail::construct_at_impl(p, std::forward<Args>(args)...);
        }
    }

    template<class T>
    static constexpr void
    destroy(Alloc& a, T* p) {
        if constexpr (detail::has_alloc_destroy<Alloc, T*>) {
            a.destroy(p);
        } else {
            // qualified: an unqualified call ADL-scans T's associated classes,
            // instantiating them -- ill-formed when T is Holder<Incomplete>*.
            std::destroy_at(p);
        }
    }

    [[nodiscard]] static constexpr size_type
    max_size(const Alloc& a) noexcept {
        if constexpr (detail::has_alloc_max_size<Alloc>) {
            return a.max_size();
        } else {
            return size_type(~size_type(0)) / sizeof(value_type);
        }
    }

    [[nodiscard]] static constexpr Alloc
    select_on_container_copy_construction(const Alloc& a) {
        if constexpr (detail::has_alloc_soccc<Alloc>) {
            return a.select_on_container_copy_construction();
        } else {
            return a;
        }
    }
};

//===----------------------------------------------------------------------===//
// allocator<T>
// (from __memory/allocator.h)
//===----------------------------------------------------------------------===//

template<class T>
class allocator {
    static_assert(!is_const_v<T>, "std::allocator does not support const types");
    static_assert(!is_volatile_v<T>, "std::allocator does not support volatile types");
public:
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using value_type      = T;
    using propagate_on_container_move_assignment = true_type;
    using is_always_equal                        = true_type;

    constexpr allocator() noexcept = default;

    template<class U>
    constexpr allocator(const allocator<U>&) noexcept {}

    [[nodiscard]] constexpr T* allocate(size_t n) {
        static_assert(sizeof(T) >= 0, "cannot allocate memory for an incomplete type");
        // Over-allocation guard: libc++ would throw bad_array_new_length here.
        // Since exceptions are disabled we trap instead.
        if (n > allocator_traits<allocator>::max_size(*this))
            __builtin_trap(); // would be bad_array_new_length
        return static_cast<T*>(::operator new(n * sizeof(T)));
    }

    [[nodiscard]] constexpr allocation_result<T*>
    allocate_at_least(size_t n) {
        return {allocate(n), n};
    }

    constexpr void deallocate(T* p, size_t) noexcept {
        ::operator delete(static_cast<void*>(p));
    }
};

template<class T, class U>
constexpr bool operator==(const allocator<T>&, const allocator<U>&) noexcept {
    return true;
}

//===----------------------------------------------------------------------===//
// allocate_at_least (C++23 free function)
//===----------------------------------------------------------------------===//

template<class Alloc>
[[nodiscard]] constexpr allocation_result<
    typename allocator_traits<Alloc>::pointer,
    typename allocator_traits<Alloc>::size_type>
allocate_at_least(Alloc& a, size_t n) {
    return allocator_traits<Alloc>::allocate_at_least(a, n);
}

//===----------------------------------------------------------------------===//
// default_delete<T> and default_delete<T[]>
// (from __memory/unique_ptr.h)
//===----------------------------------------------------------------------===//

template<class T>
struct default_delete {
    static_assert(!is_function_v<T>,
        "default_delete cannot be instantiated for function types");

    constexpr default_delete() noexcept = default;

    template<class U>
        requires is_convertible_v<U*, T*>
    constexpr default_delete(const default_delete<U>&) noexcept {}

    constexpr void operator()(T* ptr) const noexcept {
        static_assert(sizeof(T) >= 0, "cannot delete an incomplete type");
        static_assert(!is_void_v<T>, "cannot delete an incomplete type");
        delete ptr;
    }
};

template<class T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;

    template<class U>
        requires is_convertible_v<U(*)[], T(*)[]>
    constexpr default_delete(const default_delete<U[]>&) noexcept {}

    template<class U>
        requires is_convertible_v<U(*)[], T(*)[]>
    constexpr void operator()(U* ptr) const noexcept {
        static_assert(sizeof(U) >= 0, "cannot delete an incomplete type");
        delete[] ptr;
    }
};

//===----------------------------------------------------------------------===//
// unique_ptr<T, D>  — non-array specialisation
// (from __memory/unique_ptr.h)
// We use a simple pair of (pointer, deleter) members rather than
// libc++'s compressed_pair for clarity; EBO is not required by the standard.
// (We do however apply [[no_unique_address]] for EBO in practice.)
//===----------------------------------------------------------------------===//

namespace detail {
    // Detect whether Deleter has a nested pointer typedef
    template<class T, class D, class = void>
    struct unique_ptr_pointer { using type = T*; };
    template<class T, class D>
    struct unique_ptr_pointer<T, D, void_t<typename D::pointer>> { using type = typename D::pointer; };
} // namespace detail

template<class T, class D = default_delete<T>>
class unique_ptr {
public:
    using element_type = T;
    using deleter_type = D;
    using pointer      = typename detail::unique_ptr_pointer<T, remove_reference_t<D>>::type;

    static_assert(!is_rvalue_reference_v<D>,
        "the specified deleter type cannot be an rvalue reference");

private:
    [[no_unique_address]] pointer ptr_{};
    [[no_unique_address]] deleter_type del_{};

    // Enable-if helpers
    template<class Up, class Ep>
    static constexpr bool move_convertible =
        is_convertible_v<typename unique_ptr<Up,Ep>::pointer, pointer> &&
        !is_array_v<Up>;

    template<class Dp>
    static constexpr bool deleter_convertible =
        (is_reference_v<D> && is_same_v<D, Dp>) ||
        (!is_reference_v<D> && is_convertible_v<Dp, D>);

    template<class Dp>
    static constexpr bool deleter_assignable = is_assignable_v<D&, Dp&&>;

public:
    // Default / nullptr constructors
    template<class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx>)
    constexpr unique_ptr() noexcept : ptr_(), del_() {}

    template<class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx>)
    constexpr unique_ptr(nullptr_t) noexcept : ptr_(), del_() {}

    // Pointer constructors
    template<class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx>)
    constexpr explicit unique_ptr(pointer p) noexcept : ptr_(p), del_() {}

    template<class Dx = D>
        requires is_copy_constructible_v<Dx>
    constexpr unique_ptr(pointer p, const D& d) noexcept : ptr_(p), del_(d) {}

    template<class Dx = D>
        requires (!is_reference_v<Dx> && is_move_constructible_v<Dx>)
    constexpr unique_ptr(pointer p, D&& d) noexcept : ptr_(p), del_(move(d)) {}

    // Delete move-from-rvalue-ref-deleter taking rvalue ref to the ref's target type
    template<class Dx = D>
        requires is_reference_v<Dx>
    unique_ptr(pointer, remove_reference_t<D>&&) = delete;

    // Move constructor
    constexpr unique_ptr(unique_ptr&& u) noexcept
        : ptr_(u.release()), del_(std::forward<D>(u.get_deleter())) {}

    // Converting move constructor
    template<class Up, class Ep>
        requires (move_convertible<Up,Ep> && deleter_convertible<Ep>)
    constexpr unique_ptr(unique_ptr<Up,Ep>&& u) noexcept
        : ptr_(u.release()), del_(std::forward<Ep>(u.get_deleter())) {}

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    constexpr ~unique_ptr() { reset(); }

    // Move assignment
    constexpr unique_ptr& operator=(unique_ptr&& u) noexcept {
        reset(u.release());
        del_ = std::forward<D>(u.get_deleter());
        return *this;
    }

    template<class Up, class Ep>
        requires (move_convertible<Up,Ep> && deleter_assignable<Ep>)
    constexpr unique_ptr& operator=(unique_ptr<Up,Ep>&& u) noexcept {
        reset(u.release());
        del_ = std::forward<Ep>(u.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    // Observers
    [[nodiscard]] constexpr add_lvalue_reference_t<T> operator*() const
        noexcept(noexcept(*declval<pointer>())) {
        return *ptr_;
    }

    constexpr pointer operator->() const noexcept { return ptr_; }
    [[nodiscard]] constexpr pointer get() const noexcept { return ptr_; }
    [[nodiscard]] constexpr deleter_type& get_deleter() noexcept { return del_; }
    [[nodiscard]] constexpr const deleter_type& get_deleter() const noexcept { return del_; }
    constexpr explicit operator bool() const noexcept { return ptr_ != nullptr; }

    // Modifiers
    constexpr pointer release() noexcept {
        pointer t = ptr_;
        ptr_ = pointer();
        return t;
    }

    constexpr void reset(pointer p = pointer()) noexcept {
        pointer tmp = ptr_;
        ptr_ = p;
        if (tmp)
            del_(tmp);
    }

    constexpr void swap(unique_ptr& u) noexcept {
        using std::swap;
        swap(ptr_, u.ptr_);
        swap(del_, u.del_);
    }
};

//===----------------------------------------------------------------------===//
// unique_ptr<T[], D>  — array specialisation
// (from __memory/unique_ptr.h)
//===----------------------------------------------------------------------===//

template<class T, class D>
class unique_ptr<T[], D> {
public:
    using element_type = T;
    using deleter_type = D;
    using pointer      = typename detail::unique_ptr_pointer<T, remove_reference_t<D>>::type;

private:
    [[no_unique_address]] pointer ptr_{};
    [[no_unique_address]] deleter_type del_{};

    // Allowed pointer types: same as pointer, or T* when pointer == T*
    template<class From>
    struct check_array_pointer : is_same<From, pointer> {};
    template<class FromElem>
    struct check_array_pointer<FromElem*>
        : bool_constant<
            is_same_v<FromElem*, pointer> ||
            (is_same_v<pointer, element_type*> &&
             is_convertible_v<FromElem(*)[], element_type(*)[]>)> {};

    template<class Up, class Ep>
    static constexpr bool move_convertible =
        is_array_v<Up> &&
        is_same_v<pointer, element_type*> &&
        is_same_v<typename unique_ptr<Up,Ep>::pointer,
                  typename remove_extent<Up>::type*> &&
        is_convertible_v<typename remove_extent<Up>::type(*)[],
                         element_type(*)[]>;

    template<class Dp>
    static constexpr bool deleter_convertible =
        (is_reference_v<D> && is_same_v<D, Dp>) ||
        (!is_reference_v<D> && is_convertible_v<Dp, D>);

    template<class Dp>
    static constexpr bool deleter_assignable = is_assignable_v<D&, Dp&&>;

public:
    template<class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx>)
    constexpr unique_ptr() noexcept : ptr_(), del_() {}

    template<class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx>)
    constexpr unique_ptr(nullptr_t) noexcept : ptr_(), del_() {}

    template<class Ptr, class Dx = D>
        requires (is_default_constructible_v<Dx> && !is_pointer_v<Dx> &&
                  check_array_pointer<Ptr>::value)
    constexpr explicit unique_ptr(Ptr p) noexcept : ptr_(p), del_() {}

    template<class Ptr, class Dx = D>
        requires (is_copy_constructible_v<Dx> && check_array_pointer<Ptr>::value)
    constexpr unique_ptr(Ptr p, const D& d) noexcept : ptr_(p), del_(d) {}

    template<class Dx = D>
        requires is_copy_constructible_v<Dx>
    constexpr unique_ptr(nullptr_t, const D& d) noexcept : ptr_(nullptr), del_(d) {}

    template<class Ptr, class Dx = D>
        requires (!is_reference_v<Dx> && is_move_constructible_v<Dx> &&
                  check_array_pointer<Ptr>::value)
    constexpr unique_ptr(Ptr p, D&& d) noexcept : ptr_(p), del_(move(d)) {}

    template<class Dx = D>
        requires (!is_reference_v<Dx> && is_move_constructible_v<Dx>)
    constexpr unique_ptr(nullptr_t, D&& d) noexcept : ptr_(nullptr), del_(move(d)) {}

    // Delete rvalue-ref-to-target of reference deleter
    template<class Ptr, class Dx = D>
        requires (is_reference_v<Dx> && check_array_pointer<Ptr>::value)
    unique_ptr(Ptr, remove_reference_t<D>&&) = delete;

    constexpr unique_ptr(unique_ptr&& u) noexcept
        : ptr_(u.release()), del_(std::forward<D>(u.get_deleter())) {}

    constexpr unique_ptr& operator=(unique_ptr&& u) noexcept {
        reset(u.release());
        del_ = std::forward<D>(u.get_deleter());
        return *this;
    }

    template<class Up, class Ep>
        requires (move_convertible<Up,Ep> && deleter_convertible<Ep>)
    constexpr unique_ptr(unique_ptr<Up,Ep>&& u) noexcept
        : ptr_(u.release()), del_(std::forward<Ep>(u.get_deleter())) {}

    template<class Up, class Ep>
        requires (move_convertible<Up,Ep> && deleter_assignable<Ep>)
    constexpr unique_ptr& operator=(unique_ptr<Up,Ep>&& u) noexcept {
        reset(u.release());
        del_ = std::forward<Ep>(u.get_deleter());
        return *this;
    }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    constexpr ~unique_ptr() { reset(); }

    constexpr unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    constexpr add_lvalue_reference_t<T> operator[](size_t i) const {
        return ptr_[i];
    }

    [[nodiscard]] constexpr pointer get() const noexcept { return ptr_; }
    [[nodiscard]] constexpr deleter_type& get_deleter() noexcept { return del_; }
    [[nodiscard]] constexpr const deleter_type& get_deleter() const noexcept { return del_; }
    constexpr explicit operator bool() const noexcept { return ptr_ != nullptr; }

    constexpr pointer release() noexcept {
        pointer t = ptr_;
        ptr_ = pointer();
        return t;
    }

    template<class Pp>
        requires check_array_pointer<Pp>::value
    constexpr void reset(Pp p) noexcept {
        pointer tmp = ptr_;
        ptr_ = p;
        if (tmp)
            del_(tmp);
    }

    constexpr void reset(nullptr_t = nullptr) noexcept {
        pointer tmp = ptr_;
        ptr_ = nullptr;
        if (tmp)
            del_(tmp);
    }

    constexpr void swap(unique_ptr& u) noexcept {
        using std::swap;
        swap(ptr_, u.ptr_);
        swap(del_, u.del_);
    }
};

//===----------------------------------------------------------------------===//
// unique_ptr free functions: swap, comparisons, operator<=>
//===----------------------------------------------------------------------===//

template<class T, class D>
    requires is_swappable_v<D>
constexpr void swap(unique_ptr<T,D>& x, unique_ptr<T,D>& y) noexcept {
    x.swap(y);
}

// unique_ptr vs unique_ptr
template<class T1, class D1, class T2, class D2>
constexpr bool operator==(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    return x.get() == y.get();
}

template<class T1, class D1, class T2, class D2>
bool operator<(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    using P1 = typename unique_ptr<T1,D1>::pointer;
    using P2 = typename unique_ptr<T2,D2>::pointer;
    using Vp = common_type_t<P1, P2>;
    return static_cast<Vp>(x.get()) < static_cast<Vp>(y.get());
}

template<class T1, class D1, class T2, class D2>
bool operator>(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    return y < x;
}

template<class T1, class D1, class T2, class D2>
bool operator<=(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    return !(y < x);
}

template<class T1, class D1, class T2, class D2>
bool operator>=(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    return !(x < y);
}

template<class T1, class D1, class T2, class D2>
    requires three_way_comparable_with<
        typename unique_ptr<T1,D1>::pointer,
        typename unique_ptr<T2,D2>::pointer>
auto operator<=>(const unique_ptr<T1,D1>& x, const unique_ptr<T2,D2>& y) {
    return compare_three_way()(x.get(), y.get());
}

// unique_ptr vs nullptr
template<class T, class D>
constexpr bool operator==(const unique_ptr<T,D>& x, nullptr_t) noexcept {
    return !x;
}

template<class T, class D>
constexpr bool operator<(const unique_ptr<T,D>& x, nullptr_t) {
    using P = typename unique_ptr<T,D>::pointer;
    return static_cast<P>(x.get()) < static_cast<P>(nullptr);
}

template<class T, class D>
constexpr bool operator<(nullptr_t, const unique_ptr<T,D>& x) {
    using P = typename unique_ptr<T,D>::pointer;
    return static_cast<P>(nullptr) < static_cast<P>(x.get());
}

template<class T, class D>
constexpr bool operator>(const unique_ptr<T,D>& x, nullptr_t) {
    return nullptr < x;
}

template<class T, class D>
constexpr bool operator>(nullptr_t, const unique_ptr<T,D>& x) {
    return x < nullptr;
}

template<class T, class D>
constexpr bool operator<=(const unique_ptr<T,D>& x, nullptr_t) {
    return !(nullptr < x);
}

template<class T, class D>
constexpr bool operator<=(nullptr_t, const unique_ptr<T,D>& x) {
    return !(x < nullptr);
}

template<class T, class D>
constexpr bool operator>=(const unique_ptr<T,D>& x, nullptr_t) {
    return !(x < nullptr);
}

template<class T, class D>
constexpr bool operator>=(nullptr_t, const unique_ptr<T,D>& x) {
    return !(nullptr < x);
}

template<class T, class D>
    requires three_way_comparable<typename unique_ptr<T,D>::pointer>
constexpr auto operator<=>(const unique_ptr<T,D>& x, nullptr_t) {
    return compare_three_way()(x.get(),
        static_cast<typename unique_ptr<T,D>::pointer>(nullptr));
}

//===----------------------------------------------------------------------===//
// make_unique / make_unique_for_overwrite
// (from __memory/unique_ptr.h)
//===----------------------------------------------------------------------===//

template<class T, class... Args>
    requires (!is_array_v<T>)
[[nodiscard]] unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(std::forward<Args>(args)...));
}

template<class T>
    requires is_unbounded_array_v<T>
[[nodiscard]] unique_ptr<T> make_unique(size_t n) {
    return unique_ptr<T>(new remove_extent_t<T>[n]());
}

template<class T, class... Args>
    requires is_bounded_array_v<T>
void make_unique(Args&&...) = delete;

template<class T>
    requires (!is_array_v<T>)
[[nodiscard]] unique_ptr<T> make_unique_for_overwrite() {
    return unique_ptr<T>(new T);
}

template<class T>
    requires is_unbounded_array_v<T>
[[nodiscard]] unique_ptr<T> make_unique_for_overwrite(size_t n) {
    return unique_ptr<T>(new remove_extent_t<T>[n]);
}

template<class T, class... Args>
    requires is_bounded_array_v<T>
void make_unique_for_overwrite(Args&&...) = delete;

//===----------------------------------------------------------------------===//
// uninitialized algorithms
// (from __memory/uninitialized_algorithms.h)
// Note: No exception guard needed under -fno-exceptions; the guard would be
// a no-op since destructors don't run on paths that can't throw.
//===----------------------------------------------------------------------===//

// uninitialized_default_construct(_n)

template<class ForwardIter>
void uninitialized_default_construct(ForwardIter first, ForwardIter last) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (auto idx = first; idx != last; ++idx)
        ::new(static_cast<void*>(addressof(*idx))) V;
}

template<class ForwardIter, class Size>
ForwardIter uninitialized_default_construct_n(ForwardIter first, Size n) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; n > 0; ++first, (void)--n)
        ::new(static_cast<void*>(addressof(*first))) V;
    return first;
}

// uninitialized_value_construct(_n)

template<class ForwardIter>
void uninitialized_value_construct(ForwardIter first, ForwardIter last) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (auto idx = first; idx != last; ++idx)
        ::new(static_cast<void*>(addressof(*idx))) V();
}

template<class ForwardIter, class Size>
ForwardIter uninitialized_value_construct_n(ForwardIter first, Size n) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; n > 0; ++first, (void)--n)
        ::new(static_cast<void*>(addressof(*first))) V();
    return first;
}

// uninitialized_copy(_n)

template<class InputIter, class ForwardIter>
ForwardIter uninitialized_copy(InputIter first, InputIter last, ForwardIter dest) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; first != last; ++first, (void)++dest)
        ::new(static_cast<void*>(addressof(*dest))) V(*first);
    return dest;
}

template<class InputIter, class Size, class ForwardIter>
ForwardIter uninitialized_copy_n(InputIter first, Size n, ForwardIter dest) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; n > 0; ++first, (void)++dest, (void)--n)
        ::new(static_cast<void*>(addressof(*dest))) V(*first);
    return dest;
}

// uninitialized_move(_n)

template<class InputIter, class ForwardIter>
ForwardIter uninitialized_move(InputIter first, InputIter last, ForwardIter dest) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; first != last; ++first, (void)++dest)
        ::new(static_cast<void*>(addressof(*dest))) V(move(*first));
    return dest;
}

template<class InputIter, class Size, class ForwardIter>
pair<InputIter, ForwardIter>
uninitialized_move_n(InputIter first, Size n, ForwardIter dest) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; n > 0; ++first, (void)++dest, (void)--n)
        ::new(static_cast<void*>(addressof(*dest))) V(move(*first));
    return {first, dest};
}

// uninitialized_fill(_n)

template<class ForwardIter, class T>
void uninitialized_fill(ForwardIter first, ForwardIter last, const T& x) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (auto idx = first; idx != last; ++idx)
        ::new(static_cast<void*>(addressof(*idx))) V(x);
}

template<class ForwardIter, class Size, class T>
ForwardIter uninitialized_fill_n(ForwardIter first, Size n, const T& x) {
    using V = typename iterator_traits<ForwardIter>::value_type;
    for (; n > 0; ++first, (void)--n)
        ::new(static_cast<void*>(addressof(*first))) V(x);
    return first;
}

//===----------------------------------------------------------------------===//
// align
// (from __memory/align.h)
//===----------------------------------------------------------------------===//

inline void* align(size_t alignment, size_t sz, void*& ptr, size_t& space) {
    void* r = nullptr;
    if (sz <= space) {
        char* p1 = static_cast<char*>(ptr);
        char* p2 = reinterpret_cast<char*>(
            reinterpret_cast<uintptr_t>(p1 + (alignment - 1)) & -alignment);
        size_t d = static_cast<size_t>(p2 - p1);
        if (d <= space - sz) {
            r    = p2;
            ptr  = r;
            space -= d;
        }
    }
    return r;
}

//===----------------------------------------------------------------------===//
// assume_aligned  (C++20)
// (from __memory/assume_aligned.h)
//===----------------------------------------------------------------------===//

// libc++ guards the __builtin_assume_aligned call with
// __libcpp_is_constant_evaluated(); during constant evaluation it just
// returns the pointer (gcc-10 rejects the builtin in constexpr contexts).
template<size_t N, class T>
[[nodiscard]] constexpr T* assume_aligned(T* ptr) noexcept {
    static_assert(N != 0 && (N & (N - 1)) == 0,
        "std::assume_aligned<N>(p) requires N to be a power of two");
    if (is_constant_evaluated()) {
        return ptr;
    } else {
        return static_cast<T*>(__builtin_assume_aligned(ptr, N));
    }
}

//===----------------------------------------------------------------------===//
// raw_storage_iterator  (C++17-deprecated, C++20-removed; kept as an extension
// — the libc++ test suite always sets
// _LIBCPP_ENABLE_CXX20_REMOVED_RAW_STORAGE_ITERATOR)
// (from __memory/raw_storage_iterator.h)
//===----------------------------------------------------------------------===//

template<class OutputIterator, class T>
class raw_storage_iterator {
private:
    OutputIterator x_;

public:
    typedef output_iterator_tag iterator_category;
    typedef void                value_type;
    typedef ptrdiff_t           difference_type;  // void before C++20
    typedef void                pointer;
    typedef void                reference;

    explicit raw_storage_iterator(OutputIterator x) : x_(x) {}
    [[nodiscard]] raw_storage_iterator& operator*() { return *this; }
    raw_storage_iterator& operator=(const T& element) {
        ::new(static_cast<void*>(std::addressof(*x_))) T(element);
        return *this;
    }
    raw_storage_iterator& operator=(T&& element) {
        ::new(static_cast<void*>(std::addressof(*x_))) T(std::move(element));
        return *this;
    }
    raw_storage_iterator& operator++() {
        ++x_;
        return *this;
    }
    raw_storage_iterator operator++(int) {
        raw_storage_iterator t(*this);
        ++x_;
        return t;
    }
    [[nodiscard]] OutputIterator base() const { return x_; }
};

//===----------------------------------------------------------------------===//
// get_temporary_buffer / return_temporary_buffer
// (C++17-deprecated, C++20-removed; kept as an extension — the libc++ test
// suite always sets _LIBCPP_ENABLE_CXX20_REMOVED_TEMPORARY_BUFFER)
// (from __memory/temporary_buffer.h; the allocation loop including the
// overaligned handling is from __memory/unique_temporary_buffer.h
// __allocate_unique_temporary_buffer; the deallocation mirrors
// __libcpp_deallocate_unsized which selects the aligned operator delete
// for overaligned types)
//===----------------------------------------------------------------------===//

template<class T>
[[nodiscard]] pair<T*, ptrdiff_t> get_temporary_buffer(ptrdiff_t n) noexcept {
    T* ptr = nullptr;
    const ptrdiff_t max_count =
        (~ptrdiff_t(0) ^ ptrdiff_t(ptrdiff_t(1) << (sizeof(ptrdiff_t) * __CHAR_BIT__ - 1))) /
        sizeof(T);
    if (n > max_count)
        n = max_count;
    while (n > 0) {
        if (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) {
            ptr = static_cast<T*>(::operator new(n * sizeof(T), align_val_t(alignof(T)), nothrow));
        } else {
            ptr = static_cast<T*>(::operator new(n * sizeof(T), nothrow));
        }
        if (ptr)
            break;
        n /= 2;
    }
    return pair<T*, ptrdiff_t>(ptr, n);
}

template<class T>
inline void return_temporary_buffer(T* p) noexcept {
    if (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
        ::operator delete(p, align_val_t(alignof(T)));
    else
        ::operator delete(p);
}

} // namespace std

// ============================================================================
// shared_ptr / weak_ptr / enable_shared_from_this / make_shared  (LEAN PROFILE)
//
// This overlay REPLACES the base <memory> shared-pointer machinery with a
// frugal, one-pointer design.  Everything ABOVE this banner (allocator,
// allocator_traits, unique_ptr, the uninitialized algorithms, default_delete,
// addressof, ...) is byte-for-byte the base header — only the smart-pointer
// family below is rewritten.
//
// THE HANDLE.  sizeof(shared_ptr<T>) == sizeof(weak_ptr<T>) == sizeof(void*):
// a shared_ptr / weak_ptr is a single pointer to a detail::sp_cb control block
// (bits/lean_sp.h); null = empty.  get() returns cb->elem reinterpreted as
// element_type* — the element pointer is stored ONCE, in the block, not per
// handle.
//
// DELIBERATE DEVIATIONS from [util.smartptr] (all documented in lean/README.md):
//
//   1. NO aliasing constructor.  A one-pointer handle has no room for a
//      per-handle element pointer, which is exactly what the aliasing
//      constructor needs — the overloads are `= delete`d.
//
//   2. POINTER-ADJUSTING CONVERSIONS TRAP.  Because every handle sharing a
//      block reinterprets the block's single stored `elem`, a converting
//      construction / assignment / pointer-cast to a type at a NONZERO offset
//      from the stored pointer (a multiple-inheritance base) would silently
//      hand back a mis-adjusted pointer.  Instead the converting paths compute
//      the adjusted pointer and __builtin_trap() when it differs from `elem`.
//      Zero-offset conversions (all single inheritance) are free.  The weak_ptr
//      conversions run the same check on the pointer VALUE only — comparing
//      addresses never dereferences the (possibly dead) object.
//
//   3. NO get_deleter (dead under -fno-rtti), NO dynamic_pointer_cast (needs
//      RTTI), NO allocate_shared / allocate_shared_for_overwrite / pmr, NO
//      atomic<shared_ptr> and NO atomic_load/store/exchange/compare_exchange
//      free-function family.  static_/const_/reinterpret_pointer_cast,
//      owner_before and owner_less are KEPT.
//
//   4. NO array support.  shared_ptr<T[]>, make_shared<T[]> and operator[] are
//      omitted: storing the element count needed to destroy an array does not
//      fit the fixed four-field block without a negative-offset trick that was
//      judged not clean enough to ship half-done.  make_shared / the pointer
//      and deleter constructors support only non-array T.
//
//   5. enable_shared_from_this is KEPT with standard semantics (make_shared and
//      the pointer constructor seed the embedded weak_ptr; shared_from_this on
//      an unowned object traps).  unique_ptr -> shared_ptr interop is KEPT
//      (it routes through the pointer / deleter constructor).
//
// Kernels: detail::sp_retain / sp_release / sp_weak_retain / sp_weak_release /
// sp_lock / sp_use_count live out of line in lean/src/kernels.cpp.
// ============================================================================

#include <bits/lean_sp.h>
#include <bits/relocatable.h>   // is_trivially_relocatable_v (specialized below)

namespace std {

// Forward declarations
template<class T> class shared_ptr;
template<class T> class weak_ptr;
template<class T> class enable_shared_from_this;

//===----------------------------------------------------------------------===//
// bad_weak_ptr — the standard exception; under -fno-exceptions we trap.
//===----------------------------------------------------------------------===//

struct bad_weak_ptr : public std::exception {
    bad_weak_ptr() noexcept = default;
    bad_weak_ptr(const bad_weak_ptr&) noexcept = default;
    bad_weak_ptr& operator=(const bad_weak_ptr&) noexcept = default;
    ~bad_weak_ptr() noexcept override = default;
    [[nodiscard]] const char* what() const noexcept override { return "bad_weak_ptr"; }
};

[[noreturn]] inline void throw_bad_weak_ptr() noexcept { __builtin_trap(); }

//===----------------------------------------------------------------------===//
// Compatibility + dispose helpers (ported from libc++ __memory/shared_ptr.h
// helper variables; the dispose thunks are the design's only per-type code).
//===----------------------------------------------------------------------===//

namespace detail {

// Y* compatible with T*  (http://eel.is/c++draft/util.smartptr.shared.general).
template<class Y, class T>
inline constexpr bool sp_bounded_convertible_to_unbounded_v = false;
template<class U, size_t N, class T>
inline constexpr bool sp_bounded_convertible_to_unbounded_v<U[N], T> =
    is_same_v<remove_cv_t<T>, U[]>;

template<class Y, class T>
inline constexpr bool sp_compatible_v =
    is_convertible_v<Y*, T*> || sp_bounded_convertible_to_unbounded_v<Y, T>;

// Raw-pointer-constructor compatibility (http://eel.is/c++draft/util.smartptr.shared.const).
template<class Y, class T, class = void>
inline constexpr bool sp_raw_ptr_compatible_v = !is_array_v<T> && is_convertible_v<Y*, T*>;
template<class Y, class U, size_t N>
inline constexpr bool
    sp_raw_ptr_compatible_v<Y, U[N], enable_if_t<is_convertible_v<Y(*)[N], U(*)[N]>>> = true;
template<class Y, class U>
inline constexpr bool
    sp_raw_ptr_compatible_v<Y, U[], enable_if_t<is_convertible_v<Y(*)[], U(*)[]>>> = true;

template<class Ptr, class = void>
inline constexpr bool sp_is_deletable_v = false;
template<class Ptr>
inline constexpr bool sp_is_deletable_v<Ptr, void_t<decltype(delete declval<Ptr>())>> = true;

template<class D, class Pt, class = void>
inline constexpr bool sp_well_formed_deleter_v = false;
template<class D, class Pt>
inline constexpr bool sp_well_formed_deleter_v<D, Pt,
    void_t<decltype(declval<D>()(declval<Pt>()))>> = true;

template<class D, class Y, class T>
inline constexpr bool sp_deleter_ctor_reqs_v =
    sp_raw_ptr_compatible_v<Y, T> &&
    is_move_constructible_v<D> &&
    sp_well_formed_deleter_v<D, Y*>;

template<class D>
inline constexpr bool sp_nullptr_deleter_ctor_reqs_v =
    is_move_constructible_v<D> &&
    sp_well_formed_deleter_v<D, nullptr_t>;

// Trap when a converting handle would reinterpret the block's single stored
// pointer at a different address than the adjusted (correct) pointer.
inline void sp_check_offset(const void* adjusted, const void* stored) noexcept {
    if (adjusted != stored)
        __builtin_trap();   // multiple-inheritance offset — see deviation 2
}

// dispose thunks — the ONLY per-type code in the whole design.

// make_shared: the object lives inline in the block; destroy it in place. The
// block (hence the storage) is freed later, on the weak-zero transition.
template<class T>
void sp_dispose_inplace(sp_cb* cb) noexcept {
    static_cast<T*>(cb->elem)->~T();
}

// shared_ptr(Y*): the object was created by the user via `new`; use `delete`
// (the base default_delete path) on the original static type Y.
template<class Y>
void sp_dispose_delete(sp_cb* cb) noexcept {
    delete static_cast<Y*>(cb->elem);
}

// shared_ptr(Y*, D): D is stored inline after the block; invoke it, then end
// its lifetime. (The block is freed on the weak-zero transition.)
template<class Y, class D>
void sp_dispose_deleter(sp_cb* cb) noexcept {
    D* d = reinterpret_cast<D*>(reinterpret_cast<char*>(cb) + sp_payload_offset(alignof(D)));
    (*d)(static_cast<Y*>(cb->elem));
    d->~D();
}

} // namespace detail

//===----------------------------------------------------------------------===//
// shared_ptr<T>  (non-array only — deviation 4)
//===----------------------------------------------------------------------===//

template<class T>
class shared_ptr {
public:
    using weak_type    = weak_ptr<T>;
    using element_type = remove_extent_t<T>;

private:
    detail::sp_cb* cb_ = nullptr;

    template<class U> friend class shared_ptr;
    template<class U> friend class weak_ptr;

    // enable_shared_from_this seeding (defined after enable_shared_from_this).
    template<class Yp, class OrigPtr>
        requires is_convertible_v<OrigPtr*, const enable_shared_from_this<Yp>*>
    void enable_weak_this(const enable_shared_from_this<Yp>* e, OrigPtr* ptr) noexcept;
    void enable_weak_this(...) noexcept {}

    // shared_ptr(Y*): fresh block, dispose = delete Y.
    template<class Y>
    void init_ptr(Y* p) {
        detail::sp_check_offset(static_cast<element_type*>(p), p);
        detail::sp_cb* c = static_cast<detail::sp_cb*>(::malloc(sizeof(detail::sp_cb)));
        if (!c) __builtin_trap();
        c->elem    = const_cast<void*>(static_cast<const volatile void*>(p));
        c->strong  = 1;
        c->weak    = 1;
        c->dispose = &detail::sp_dispose_delete<Y>;
        cb_ = c;
        enable_weak_this(p, p);
    }

    // shared_ptr(Y*, D): fresh block with D stored inline after it.
    template<class Y, class D>
    void init_ptr_deleter(Y* p, D d) {
        detail::sp_check_offset(static_cast<element_type*>(p), p);
        static_assert(alignof(D) <= alignof(max_align_t),
            "over-aligned deleter is not supported by lean shared_ptr");
        size_t off = detail::sp_payload_offset(alignof(D));
        detail::sp_cb* c = static_cast<detail::sp_cb*>(::malloc(off + sizeof(D)));
        if (!c) __builtin_trap();
        c->elem    = const_cast<void*>(static_cast<const volatile void*>(p));
        c->strong  = 1;
        c->weak    = 1;
        c->dispose = &detail::sp_dispose_deleter<Y, D>;
        ::new (static_cast<void*>(reinterpret_cast<char*>(c) + off)) D(std::move(d));
        cb_ = c;
        enable_weak_this(p, p);
    }

    // nullptr + D: a block with no managed object, D stored inline.
    template<class D>
    void init_null_deleter(D d) {
        static_assert(alignof(D) <= alignof(max_align_t),
            "over-aligned deleter is not supported by lean shared_ptr");
        size_t off = detail::sp_payload_offset(alignof(D));
        detail::sp_cb* c = static_cast<detail::sp_cb*>(::malloc(off + sizeof(D)));
        if (!c) __builtin_trap();
        c->elem    = nullptr;
        c->strong  = 1;
        c->weak    = 1;
        c->dispose = &detail::sp_dispose_deleter<remove_cv_t<T>, D>;
        ::new (static_cast<void*>(reinterpret_cast<char*>(c) + off)) D(std::move(d));
        cb_ = c;
    }

    // Adopt a block whose strong count sp_lock already incremented (weak_ptr::lock).
    static shared_ptr adopt_locked(detail::sp_cb* locked) noexcept {
        shared_ptr r;
        r.cb_ = locked;
        return r;
    }

public:
    // --- Internal factories used by make_shared and the pointer casts.  Public
    //     because the free functions that call them are not friends; not part
    //     of the standard surface. ---

    // Adopt a freshly built owning block (strong == 1, no extra retain) and seed
    // enable_shared_from_this.
    static shared_ptr adopt_owning(detail::sp_cb* c, element_type* obj) noexcept {
        shared_ptr r;
        r.cb_ = c;
        r.enable_weak_this(obj, obj);
        return r;
    }

    // static_pointer_cast: share the source block after checking the adjustment.
    template<class U>
    static shared_ptr sp_static_cast(const shared_ptr<U>& r) noexcept {
        shared_ptr res;
        res.cb_ = r.cb_;
        if (res.cb_) {
            element_type* t = static_cast<element_type*>(static_cast<U*>(res.cb_->elem));
            detail::sp_check_offset(t, res.cb_->elem);
            detail::sp_retain(res.cb_);
        }
        return res;
    }
    template<class U>
    static shared_ptr sp_static_cast(shared_ptr<U>&& r) noexcept {
        shared_ptr res;
        res.cb_ = r.cb_;
        if (res.cb_) {
            element_type* t = static_cast<element_type*>(static_cast<U*>(res.cb_->elem));
            detail::sp_check_offset(t, res.cb_->elem);
        }
        r.cb_ = nullptr;
        return res;
    }

    // const_/reinterpret_pointer_cast never change the address, so no check.
    template<class U>
    static shared_ptr sp_reinterpret_share(const shared_ptr<U>& r) noexcept {
        shared_ptr res;
        res.cb_ = r.cb_;
        if (res.cb_)
            detail::sp_retain(res.cb_);
        return res;
    }
    template<class U>
    static shared_ptr sp_reinterpret_share(shared_ptr<U>&& r) noexcept {
        shared_ptr res;
        res.cb_ = r.cb_;
        r.cb_ = nullptr;
        return res;
    }

    // --- Constructors ---

    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    template<class Y>
        requires (detail::sp_raw_ptr_compatible_v<Y, T> && detail::sp_is_deletable_v<Y*>)
    explicit shared_ptr(Y* p) { init_ptr(p); }

    template<class Y, class D>
        requires detail::sp_deleter_ctor_reqs_v<D, Y, T>
    shared_ptr(Y* p, D d) { init_ptr_deleter(p, std::move(d)); }

    // (Y*, D, Alloc): the allocator is ignored (lean has no custom allocators);
    // the deleter path is identical.
    template<class Y, class D, class Alloc>
        requires detail::sp_deleter_ctor_reqs_v<D, Y, T>
    shared_ptr(Y* p, D d, Alloc) { init_ptr_deleter(p, std::move(d)); }

    template<class D>
        requires detail::sp_nullptr_deleter_ctor_reqs_v<D>
    shared_ptr(nullptr_t, D d) { init_null_deleter(std::move(d)); }

    template<class D, class Alloc>
        requires detail::sp_nullptr_deleter_ctor_reqs_v<D>
    shared_ptr(nullptr_t, D d, Alloc) { init_null_deleter(std::move(d)); }

    // Aliasing constructors — deviation 1: no per-handle element pointer exists.
    template<class Y>
    shared_ptr(const shared_ptr<Y>&, element_type*) = delete;
    template<class Y>
    shared_ptr(shared_ptr<Y>&&, element_type*) = delete;

    shared_ptr(const shared_ptr& r) noexcept : cb_(r.cb_) {
        if (cb_) detail::sp_retain(cb_);
    }

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    shared_ptr(const shared_ptr<Y>& r) noexcept : cb_(r.cb_) {
        if (cb_) {
            element_type* t = static_cast<Y*>(cb_->elem);
            detail::sp_check_offset(t, cb_->elem);
            detail::sp_retain(cb_);
        }
    }

    shared_ptr(shared_ptr&& r) noexcept : cb_(r.cb_) { r.cb_ = nullptr; }

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    shared_ptr(shared_ptr<Y>&& r) noexcept : cb_(r.cb_) {
        if (cb_) {
            element_type* t = static_cast<Y*>(cb_->elem);
            detail::sp_check_offset(t, cb_->elem);
        }
        r.cb_ = nullptr;
    }

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    explicit shared_ptr(const weak_ptr<Y>& r) {
        detail::sp_cb* c = r.cb_ ? detail::sp_lock(r.cb_) : nullptr;
        if (!c)
            throw_bad_weak_ptr();
        element_type* t = static_cast<Y*>(c->elem);
        detail::sp_check_offset(t, c->elem);   // strong already held: safe to read elem
        cb_ = c;
    }

    template<class Y, class D>
        requires (detail::sp_compatible_v<Y, T> &&
                  is_convertible_v<typename unique_ptr<Y, D>::pointer, element_type*>)
    shared_ptr(unique_ptr<Y, D>&& u) {
        Y* p = u.get();
        if (p == nullptr) {
            cb_ = nullptr;
            return;
        }
        if constexpr (is_same_v<D, default_delete<Y>>) {
            init_ptr(p);
        } else {
            using Del = conditional_t<is_lvalue_reference_v<D>,
                                      reference_wrapper<remove_reference_t<D>>, D>;
            init_ptr_deleter<Y, Del>(p, std::forward<D>(u.get_deleter()));
        }
        u.release();
    }

    ~shared_ptr() {
        if (cb_) detail::sp_release(cb_);
    }

    // --- Assignment (copy/move-and-swap; runs the converting checks) ---

    shared_ptr& operator=(const shared_ptr& r) noexcept { shared_ptr(r).swap(*this); return *this; }
    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    shared_ptr& operator=(const shared_ptr<Y>& r) noexcept { shared_ptr(r).swap(*this); return *this; }
    shared_ptr& operator=(shared_ptr&& r) noexcept { shared_ptr(std::move(r)).swap(*this); return *this; }
    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    shared_ptr& operator=(shared_ptr<Y>&& r) noexcept { shared_ptr(std::move(r)).swap(*this); return *this; }
    template<class Y, class D>
        requires (detail::sp_compatible_v<Y, T> &&
                  is_convertible_v<typename unique_ptr<Y, D>::pointer, element_type*>)
    shared_ptr& operator=(unique_ptr<Y, D>&& r) { shared_ptr(std::move(r)).swap(*this); return *this; }

    // --- Modifiers ---

    void swap(shared_ptr& r) noexcept { detail::sp_cb* t = cb_; cb_ = r.cb_; r.cb_ = t; }
    void reset() noexcept { shared_ptr().swap(*this); }
    template<class Y>
        requires detail::sp_raw_ptr_compatible_v<Y, T>
    void reset(Y* p) { shared_ptr(p).swap(*this); }
    template<class Y, class D>
        requires detail::sp_deleter_ctor_reqs_v<D, Y, T>
    void reset(Y* p, D d) { shared_ptr(p, std::move(d)).swap(*this); }
    template<class Y, class D, class Alloc>
        requires detail::sp_deleter_ctor_reqs_v<D, Y, T>
    void reset(Y* p, D d, Alloc a) { shared_ptr(p, std::move(d), a).swap(*this); }

    // --- Observers ---  (elem-first block: get() is a zero-displacement load)

    [[nodiscard]] element_type* get() const noexcept {
        return cb_ ? static_cast<element_type*>(cb_->elem) : nullptr;
    }
    [[nodiscard]] add_lvalue_reference_t<element_type> operator*() const noexcept {
        return *static_cast<element_type*>(cb_->elem);
    }
    element_type* operator->() const noexcept { return static_cast<element_type*>(cb_->elem); }

    [[nodiscard]] long use_count() const noexcept {
        return cb_ ? static_cast<long>(detail::sp_use_count(cb_)) : 0;
    }
    [[nodiscard]] bool unique() const noexcept { return use_count() == 1; }
    explicit operator bool() const noexcept { return get() != nullptr; }

    template<class U>
    [[nodiscard]] bool owner_before(const shared_ptr<U>& p) const noexcept { return cb_ < p.cb_; }
    template<class U>
    [[nodiscard]] bool owner_before(const weak_ptr<U>& p) const noexcept { return cb_ < p.cb_; }
};

//===----------------------------------------------------------------------===//
// weak_ptr<T>
//===----------------------------------------------------------------------===//

template<class T>
class weak_ptr {
public:
    using element_type = remove_extent_t<T>;

private:
    detail::sp_cb* cb_ = nullptr;

    template<class U> friend class shared_ptr;
    template<class U> friend class weak_ptr;

    // Seed enable_shared_from_this's embedded weak_ptr: share cb, checking the
    // element adjustment WITHOUT dereferencing the object.
    static weak_ptr seed(detail::sp_cb* cb, element_type* checked) noexcept {
        weak_ptr w;
        w.cb_ = cb;
        if (cb) {
            detail::sp_check_offset(checked, cb->elem);
            detail::sp_weak_retain(cb);
        }
        return w;
    }

public:
    constexpr weak_ptr() noexcept = default;

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr(const shared_ptr<Y>& r) noexcept : cb_(r.cb_) {
        if (cb_) {
            element_type* t = static_cast<Y*>(cb_->elem);
            detail::sp_check_offset(t, cb_->elem);
            detail::sp_weak_retain(cb_);
        }
    }

    weak_ptr(const weak_ptr& r) noexcept : cb_(r.cb_) {
        if (cb_) detail::sp_weak_retain(cb_);
    }

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr(const weak_ptr<Y>& r) noexcept : cb_(r.cb_) {
        if (cb_) {
            // Pointer-value comparison only — never touches the managed object,
            // which a weak_ptr may outlive (deviation 2).
            element_type* t = static_cast<Y*>(cb_->elem);
            detail::sp_check_offset(t, cb_->elem);
            detail::sp_weak_retain(cb_);
        }
    }

    weak_ptr(weak_ptr&& r) noexcept : cb_(r.cb_) { r.cb_ = nullptr; }

    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr(weak_ptr<Y>&& r) noexcept : cb_(r.cb_) {
        if (cb_) {
            element_type* t = static_cast<Y*>(cb_->elem);
            detail::sp_check_offset(t, cb_->elem);
        }
        r.cb_ = nullptr;
    }

    ~weak_ptr() {
        if (cb_) detail::sp_weak_release(cb_);
    }

    weak_ptr& operator=(const weak_ptr& r) noexcept { weak_ptr(r).swap(*this); return *this; }
    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr& operator=(const weak_ptr<Y>& r) noexcept { weak_ptr(r).swap(*this); return *this; }
    weak_ptr& operator=(weak_ptr&& r) noexcept { weak_ptr(std::move(r)).swap(*this); return *this; }
    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr& operator=(weak_ptr<Y>&& r) noexcept { weak_ptr(std::move(r)).swap(*this); return *this; }
    template<class Y>
        requires detail::sp_compatible_v<Y, T>
    weak_ptr& operator=(const shared_ptr<Y>& r) noexcept { weak_ptr(r).swap(*this); return *this; }

    void swap(weak_ptr& r) noexcept { detail::sp_cb* t = cb_; cb_ = r.cb_; r.cb_ = t; }
    void reset() noexcept { weak_ptr().swap(*this); }

    [[nodiscard]] long use_count() const noexcept {
        return cb_ ? static_cast<long>(detail::sp_use_count(cb_)) : 0;
    }
    [[nodiscard]] bool expired() const noexcept {
        return cb_ == nullptr || detail::sp_use_count(cb_) == 0;
    }

    [[nodiscard]] shared_ptr<T> lock() const noexcept {
        if (!cb_)
            return shared_ptr<T>();
        return shared_ptr<T>::adopt_locked(detail::sp_lock(cb_));
    }

    template<class U>
    [[nodiscard]] bool owner_before(const shared_ptr<U>& r) const noexcept { return cb_ < r.cb_; }
    template<class U>
    [[nodiscard]] bool owner_before(const weak_ptr<U>& r) const noexcept { return cb_ < r.cb_; }
};

// Deduction guides
template<class T> weak_ptr(shared_ptr<T>) -> weak_ptr<T>;
template<class T> shared_ptr(weak_ptr<T>) -> shared_ptr<T>;
template<class T, class D> shared_ptr(unique_ptr<T, D>) -> shared_ptr<T>;

//===----------------------------------------------------------------------===//
// enable_shared_from_this
//===----------------------------------------------------------------------===//

template<class T>
class enable_shared_from_this {
    mutable weak_ptr<T> weak_this_;

    template<class U> friend class shared_ptr;

protected:
    constexpr enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this&) noexcept {}
    enable_shared_from_this& operator=(const enable_shared_from_this&) noexcept { return *this; }
    ~enable_shared_from_this() {}

public:
    [[nodiscard]] shared_ptr<T> shared_from_this() { return shared_ptr<T>(weak_this_); }
    [[nodiscard]] shared_ptr<const T> shared_from_this() const { return shared_ptr<const T>(weak_this_); }
    [[nodiscard]] weak_ptr<T> weak_from_this() noexcept { return weak_this_; }
    [[nodiscard]] weak_ptr<const T> weak_from_this() const noexcept { return weak_this_; }
};

template<class T>
template<class Yp, class OrigPtr>
    requires is_convertible_v<OrigPtr*, const enable_shared_from_this<Yp>*>
void shared_ptr<T>::enable_weak_this(
    const enable_shared_from_this<Yp>* e, OrigPtr* ptr) noexcept
{
    using RawYp = remove_cv_t<Yp>;
    if (e && e->weak_this_.expired()) {
        e->weak_this_ = weak_ptr<Yp>::seed(
            cb_, const_cast<RawYp*>(static_cast<const Yp*>(ptr)));
    }
}

//===----------------------------------------------------------------------===//
// free functions: swap, comparisons, operator<<
//===----------------------------------------------------------------------===//

template<class T> void swap(shared_ptr<T>& x, shared_ptr<T>& y) noexcept { x.swap(y); }
template<class T> void swap(weak_ptr<T>& x, weak_ptr<T>& y) noexcept { x.swap(y); }

template<class T, class U>
bool operator==(const shared_ptr<T>& x, const shared_ptr<U>& y) noexcept { return x.get() == y.get(); }
template<class T, class U>
strong_ordering operator<=>(const shared_ptr<T>& x, const shared_ptr<U>& y) noexcept {
    return compare_three_way()(x.get(), y.get());
}
template<class T>
bool operator==(const shared_ptr<T>& x, nullptr_t) noexcept { return !x; }
template<class T>
strong_ordering operator<=>(const shared_ptr<T>& x, nullptr_t) noexcept {
    return compare_three_way()(x.get(), static_cast<typename shared_ptr<T>::element_type*>(nullptr));
}

template<class CharT, class Traits, class Y>
inline basic_ostream<CharT, Traits>&
operator<<(basic_ostream<CharT, Traits>& os, shared_ptr<Y> const& p) { return os << p.get(); }

template<class CharT, class Traits, class Y, class D,
         class = enable_if_t<is_same_v<void, void_t<decltype(
             declval<basic_ostream<CharT, Traits>&>() << declval<typename unique_ptr<Y, D>::pointer>())>>>>
inline basic_ostream<CharT, Traits>&
operator<<(basic_ostream<CharT, Traits>& os, unique_ptr<Y, D> const& p) { return os << p.get(); }

//===----------------------------------------------------------------------===//
// Pointer casts (RTTI-free subset — no dynamic_pointer_cast; deviation 3).
// A cast to a multiple-inheritance base traps (deviation 2, via sp_static_cast).
//===----------------------------------------------------------------------===//

template<class T, class U>
[[nodiscard]] shared_ptr<T> static_pointer_cast(const shared_ptr<U>& r) noexcept {
    return shared_ptr<T>::sp_static_cast(r);
}
template<class T, class U>
[[nodiscard]] shared_ptr<T> static_pointer_cast(shared_ptr<U>&& r) noexcept {
    return shared_ptr<T>::sp_static_cast(std::move(r));
}
template<class T, class U>
[[nodiscard]] shared_ptr<T> const_pointer_cast(const shared_ptr<U>& r) noexcept {
    return shared_ptr<T>::sp_reinterpret_share(r);
}
template<class T, class U>
[[nodiscard]] shared_ptr<T> const_pointer_cast(shared_ptr<U>&& r) noexcept {
    return shared_ptr<T>::sp_reinterpret_share(std::move(r));
}
template<class T, class U>
[[nodiscard]] shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U>& r) noexcept {
    return shared_ptr<T>::sp_reinterpret_share(r);
}
template<class T, class U>
[[nodiscard]] shared_ptr<T> reinterpret_pointer_cast(shared_ptr<U>&& r) noexcept {
    return shared_ptr<T>::sp_reinterpret_share(std::move(r));
}

//===----------------------------------------------------------------------===//
// owner_less
//===----------------------------------------------------------------------===//

template<class T = void>
struct owner_less;

template<class T>
struct owner_less<shared_ptr<T>> {
    bool operator()(const shared_ptr<T>& x, const shared_ptr<T>& y) const noexcept { return x.owner_before(y); }
    bool operator()(const shared_ptr<T>& x, const weak_ptr<T>& y) const noexcept { return x.owner_before(y); }
    bool operator()(const weak_ptr<T>& x, const shared_ptr<T>& y) const noexcept { return x.owner_before(y); }
};
template<class T>
struct owner_less<weak_ptr<T>> {
    bool operator()(const weak_ptr<T>& x, const weak_ptr<T>& y) const noexcept { return x.owner_before(y); }
    bool operator()(const shared_ptr<T>& x, const weak_ptr<T>& y) const noexcept { return x.owner_before(y); }
    bool operator()(const weak_ptr<T>& x, const shared_ptr<T>& y) const noexcept { return x.owner_before(y); }
};
template<>
struct owner_less<void> {
    using is_transparent = void;
    template<class T, class U>
    bool operator()(const shared_ptr<T>& x, const shared_ptr<U>& y) const noexcept { return x.owner_before(y); }
    template<class T, class U>
    bool operator()(const shared_ptr<T>& x, const weak_ptr<U>& y) const noexcept { return x.owner_before(y); }
    template<class T, class U>
    bool operator()(const weak_ptr<T>& x, const shared_ptr<U>& y) const noexcept { return x.owner_before(y); }
    template<class T, class U>
    bool operator()(const weak_ptr<T>& x, const weak_ptr<U>& y) const noexcept { return x.owner_before(y); }
};

//===----------------------------------------------------------------------===//
// make_shared / make_shared_for_overwrite  (ONE allocation; non-array only)
//===----------------------------------------------------------------------===//

namespace detail {

template<class T, bool ForOverwrite, class... Args>
shared_ptr<T> sp_make(Args&&... args) {
    static_assert(alignof(T) <= alignof(max_align_t),
        "over-aligned T is not supported by lean make_shared");
    // ONE malloc: control block, then T placed at sp_payload_offset(alignof(T)).
    size_t off = sp_payload_offset(alignof(T));
    sp_cb* c = static_cast<sp_cb*>(::malloc(off + sizeof(T)));
    if (!c) __builtin_trap();
    T* obj = reinterpret_cast<T*>(reinterpret_cast<char*>(c) + off);
    if constexpr (ForOverwrite)
        ::new (static_cast<void*>(obj)) T;                       // default-init
    else
        ::new (static_cast<void*>(obj)) T(std::forward<Args>(args)...);
    c->elem    = obj;
    c->strong  = 1;
    c->weak    = 1;
    c->dispose = &sp_dispose_inplace<T>;
    return shared_ptr<T>::adopt_owning(c, obj);
}

} // namespace detail

template<class T, class... Args>
    requires (!is_array_v<T>)
[[nodiscard]] shared_ptr<T> make_shared(Args&&... args) {
    return detail::sp_make<T, false>(std::forward<Args>(args)...);
}

template<class T>
    requires (!is_array_v<T>)
[[nodiscard]] shared_ptr<T> make_shared_for_overwrite() {
    return detail::sp_make<T, true>();
}

//===----------------------------------------------------------------------===//
// hash specialisations for shared_ptr and unique_ptr
//===----------------------------------------------------------------------===//

template<class T>
struct hash<shared_ptr<T>> {
    [[nodiscard]] size_t operator()(const shared_ptr<T>& p) const noexcept {
        return hash<typename shared_ptr<T>::element_type*>()(p.get());
    }
};

namespace detail {
template<class Key, class Hash = hash<Key>>
inline constexpr bool check_hash_requirements_v =
    is_copy_constructible_v<Hash> && is_move_constructible_v<Hash> &&
    is_invocable_r_v<size_t, Hash, const Key&>;
template<class Key, class Hash = hash<Key>>
inline constexpr bool has_enabled_hash_v =
    check_hash_requirements_v<Key, Hash> && is_default_constructible_v<Hash>;
template<class Type, class>
using enable_hash_helper_imp = Type;
template<class Type, class... Keys>
using enable_hash_helper =
    enable_hash_helper_imp<Type, enable_if_t<(has_enabled_hash_v<Keys> && ...)>>;
} // namespace detail

template<class T, class D>
struct hash<detail::enable_hash_helper<unique_ptr<T, D>, typename unique_ptr<T, D>::pointer>> {
    [[nodiscard]] size_t operator()(const unique_ptr<T, D>& p) const {
        using pointer = typename unique_ptr<T, D>::pointer;
        return hash<pointer>()(p.get());
    }
};

//===----------------------------------------------------------------------===//
// Trivial-relocatability: a shared_ptr / weak_ptr is one self-contained pointer,
// so vector<shared_ptr<T>> takes the memcpy/realloc growth path.  (Specialized
// here, NOT in the frozen base bits/relocatable.h.)
//===----------------------------------------------------------------------===//

namespace detail {
template<class T> inline constexpr bool is_trivially_relocatable_v<shared_ptr<T>> = true;
template<class T> inline constexpr bool is_trivially_relocatable_v<weak_ptr<T>> = true;
} // namespace detail

