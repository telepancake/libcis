// bind, is_bind_expression, is_placeholder, placeholders
// (from libc++ __functional/bind.h)
//===----------------------------------------------------------------------===//

// is_bind_expression
// Strips cv/ref so that const bind_impl& -> is_bind_expression<bind_impl>
template<class T>
struct is_bind_expression
    : conditional_t<is_same_v<T, remove_cvref_t<T>>,
                    false_type,
                    is_bind_expression<remove_cvref_t<T>>> {};
template<class T>
inline constexpr bool is_bind_expression_v = is_bind_expression<T>::value;

// is_placeholder: default is 0 (not a placeholder)
// Strips cv/ref so const ph<1>& -> is_placeholder<ph<1>>
template<class T>
struct is_placeholder
    : conditional_t<is_same_v<T, remove_cvref_t<T>>,
                    integral_constant<int, 0>,
                    is_placeholder<remove_cvref_t<T>>> {};
template<class T>
inline constexpr int is_placeholder_v = is_placeholder<T>::value;

namespace placeholders {

template<int N>
struct ph {};

// Placeholders as inline constexpr (no shared-library ABI dependency here)
inline constexpr ph<1>  _1{};
inline constexpr ph<2>  _2{};
inline constexpr ph<3>  _3{};
inline constexpr ph<4>  _4{};
inline constexpr ph<5>  _5{};
inline constexpr ph<6>  _6{};
inline constexpr ph<7>  _7{};
inline constexpr ph<8>  _8{};
inline constexpr ph<9>  _9{};
inline constexpr ph<10> _10{};

} // namespace placeholders

template<int N>
struct is_placeholder<placeholders::ph<N>> : integral_constant<int, N> {};

// is_ref_wrapper helper
namespace detail {
    template<class T>
    inline constexpr bool is_ref_wrapper_v = false;
    template<class T>
    inline constexpr bool is_ref_wrapper_v<reference_wrapper<T>> = true;
}

// mu: maps a bound argument to its effective value for bind invocation
// Case 1: reference_wrapper<T> -> unwrap
template<class T, class Uj>
constexpr T& mu_impl(reference_wrapper<T> t, Uj&) {
    return t.get();
}

// Case 2: bind_expression -> call it with the call args
template<class Ti, class... Uj>
    requires is_bind_expression_v<Ti>
constexpr invoke_result_t<Ti&, Uj...>
mu_impl(Ti& ti, tuple<Uj...>& uj) {
    return [&]<size_t... Indices>(index_sequence<Indices...>) -> invoke_result_t<Ti&, Uj...> {
        return ti(std::forward<Uj>(std::get<Indices>(uj))...);
    }(index_sequence_for<Uj...>{});
}

// Case 3: placeholder -> forward the call arg
template<class Ti, class Uj>
    requires (0 < is_placeholder_v<Ti>)
constexpr auto mu_impl(Ti&, Uj& uj)
    -> tuple_element_t<is_placeholder_v<Ti> - 1, Uj>&&
{
    constexpr size_t idx = is_placeholder_v<Ti> - 1;
    return std::forward<tuple_element_t<idx, Uj>>(std::get<idx>(uj));
}

// Case 4: plain value -> return lvalue ref
template<class Ti, class Uj>
    requires (!is_bind_expression_v<Ti> &&
              is_placeholder_v<Ti> == 0 &&
              !detail::is_ref_wrapper_v<Ti>)
constexpr Ti& mu_impl(Ti& ti, Uj&) {
    return ti;
}

// mu_return: deduce the return type of mu_impl
namespace detail {

    template<class Ti, class TupleUj>
    struct mu_return;

    // reference_wrapper case
    template<class T, class TupleUj>
    struct mu_return<reference_wrapper<T>, TupleUj> {
        using type = T&;
    };

    // bind_expression case.  Lazy, like libc++'s __mu_return_invokable: when
    // the nested bind expression is not invocable with these args, yield nat
    // instead of hard-erroring inside invoke_result_t (the const-callable
    // probe of an outer bind must be able to fail softly — PR16343).
    struct mu_return_nat { using type = nat; };

    template<class Ti, class... Uj>
        requires is_bind_expression_v<Ti>
    struct mu_return<Ti, tuple<Uj...>> {
        using type = typename conditional_t<is_invocable_v<Ti&, Uj...>,
                                            invoke_result<Ti&, Uj...>,
                                            mu_return_nat>::type;
    };

    // placeholder case (only when the placeholder index fits the call args,
    // mirroring libc++'s __mu_return dispatch)
    template<class Ti, class TupleUj>
        requires (0 < is_placeholder_v<Ti> &&
                  is_placeholder_v<Ti> <= tuple_size_v<TupleUj>)
    struct mu_return<Ti, TupleUj> {
        using type = tuple_element_t<is_placeholder_v<Ti> - 1, TupleUj>&&;
    };

    // plain value case (also covers out-of-range placeholders, like libc++)
    template<class Ti, class TupleUj>
        requires (!is_bind_expression_v<Ti> &&
                  !(0 < is_placeholder_v<Ti> &&
                    is_placeholder_v<Ti> <= tuple_size_v<TupleUj>) &&
                  !is_ref_wrapper_v<Ti>)
    struct mu_return<Ti, TupleUj> {
        using type = Ti&;
    };

} // namespace detail

// is_valid_bind_return and bind_return: deduce invocation return type
namespace detail {

    template<class Fp, class BoundArgs, class TupleUj>
    struct is_valid_bind_return : false_type {};

    template<class Fp, class... BoundArgs, class TupleUj>
    struct is_valid_bind_return<Fp, tuple<BoundArgs...>, TupleUj>
        : bool_constant<is_invocable_v<Fp,
              typename mu_return<BoundArgs, TupleUj>::type...>> {};

    template<class Fp, class... BoundArgs, class TupleUj>
    struct is_valid_bind_return<Fp, const tuple<BoundArgs...>, TupleUj>
        : bool_constant<is_invocable_v<Fp,
              typename mu_return<const BoundArgs, TupleUj>::type...>> {};

    template<class Fp, class BoundArgs, class TupleUj,
             bool = is_valid_bind_return<Fp, BoundArgs, TupleUj>::value>
    struct bind_return {};

    template<class Fp, class... BoundArgs, class TupleUj>
    struct bind_return<Fp, tuple<BoundArgs...>, TupleUj, true> {
        using type = invoke_result_t<Fp&,
            typename mu_return<BoundArgs, TupleUj>::type...>;
    };

    template<class Fp, class... BoundArgs, class TupleUj>
    struct bind_return<Fp, const tuple<BoundArgs...>, TupleUj, true> {
        using type = invoke_result_t<Fp&,
            typename mu_return<const BoundArgs, TupleUj>::type...>;
    };

} // namespace detail

// apply_functor: call f with bound args expanded through mu_impl
template<class Fp, class BoundArgs, size_t... Indx, class Args>
constexpr typename detail::bind_return<Fp, BoundArgs, Args>::type
apply_functor_impl(Fp& f, BoundArgs& bound_args,
                   index_sequence<Indx...>, Args&& args) {
    return detail::invoke_impl(f,
        std::mu_impl(std::get<Indx>(bound_args), args)...);
}

// bind_impl (internal class)
template<class Fp, class... BoundArgs>
class bind_impl {
protected:
    using Fd = decay_t<Fp>;
    using Td = tuple<decay_t<BoundArgs>...>;

private:
    Fd f_;
    Td bound_args_;

public:
    template<class Gp, class... BA>
        requires is_constructible_v<Fd, Gp> &&
                 (!is_same_v<remove_reference_t<Gp>, bind_impl>)
    explicit constexpr bind_impl(Gp&& f, BA&&... bound_args)
        : f_(std::forward<Gp>(f)), bound_args_(std::forward<BA>(bound_args)...) {}

    template<class... Args>
    constexpr typename detail::bind_return<Fd, Td, tuple<Args&&...>>::type
    operator()(Args&&... args) {
        return std::apply_functor_impl(f_, bound_args_,
            index_sequence_for<BoundArgs...>(),
            tuple<Args&&...>(std::forward<Args>(args)...));
    }

    template<class... Args>
    constexpr typename detail::bind_return<const Fd, const Td, tuple<Args&&...>>::type
    operator()(Args&&... args) const {
        return std::apply_functor_impl(f_, bound_args_,
            index_sequence_for<BoundArgs...>(),
            tuple<Args&&...>(std::forward<Args>(args)...));
    }
};

template<class Fp, class... BoundArgs>
struct is_bind_expression<bind_impl<Fp, BoundArgs...>> : true_type {};

// bind_r_impl: typed result bind
template<class Rp, class Fp, class... BoundArgs>
class bind_r_impl : public bind_impl<Fp, BoundArgs...> {
    using base = bind_impl<Fp, BoundArgs...>;
    using Fd   = typename base::Fd;
    using Td   = typename base::Td;

public:
    using result_type = Rp;

    template<class Gp, class... BA>
        requires is_constructible_v<Fd, Gp> &&
                 (!is_same_v<remove_reference_t<Gp>, bind_r_impl>)
    explicit constexpr bind_r_impl(Gp&& f, BA&&... bound_args)
        : base(std::forward<Gp>(f), std::forward<BA>(bound_args)...) {}

    template<class... Args>
        requires (is_convertible_v<typename detail::bind_return<Fd, Td, tuple<Args&&...>>::type, Rp>
                  || is_void_v<Rp>)
    constexpr Rp operator()(Args&&... args) {
        return std::invoke_r<Rp>(static_cast<base&>(*this), std::forward<Args>(args)...);
    }

    template<class... Args>
        requires (is_convertible_v<typename detail::bind_return<const Fd, const Td, tuple<Args&&...>>::type, Rp>
                  || is_void_v<Rp>)
    constexpr Rp operator()(Args&&... args) const {
        return std::invoke_r<Rp>(static_cast<const base&>(*this), std::forward<Args>(args)...);
    }
};

template<class Rp, class Fp, class... BoundArgs>
struct is_bind_expression<bind_r_impl<Rp, Fp, BoundArgs...>> : true_type {};

// bind (untyped)
template<class Fp, class... BoundArgs>
[[nodiscard]] constexpr bind_impl<Fp, BoundArgs...>
bind(Fp&& f, BoundArgs&&... bound_args) {
    return bind_impl<Fp, BoundArgs...>(std::forward<Fp>(f), std::forward<BoundArgs>(bound_args)...);
}

// bind (typed result)
template<class Rp, class Fp, class... BoundArgs>
[[nodiscard]] constexpr bind_r_impl<Rp, Fp, BoundArgs...>
bind(Fp&& f, BoundArgs&&... bound_args) {
    return bind_r_impl<Rp, Fp, BoundArgs...>(std::forward<Fp>(f), std::forward<BoundArgs>(bound_args)...);
}

//===----------------------------------------------------------------------===//
// std::function<R(Args...)>  (LEAN PROFILE — 2-word type erasure, no vtable)
// (rewrites libc++ __functional/function.h; keeps its deduction guides,
//  comparisons and swap byte-identical)
//
// THE OBJECT.  sizeof(function<R(Args...)>) == 2 * sizeof(void*):
//
//     struct { void* ctx; R (*invoke)(void*, Args...); };
//
//   operator()(a...) is simply `invoke(ctx, a...)` after a null check — there
//   is NO vtable and NO indirection table in the hot path.  The invoker is
//   loaded from the object's own second word and called with the first word.
//
// FOUR STORAGE MODES, discriminated purely by the IDENTITY of `invoke` (never
// by tag bits in a pointer — function-pointer low bits are meaningful on
// Thumb/ARM, so tagging them is unsafe):
//
//   1. ONE-WORD trivially-copyable callable (sizeof <= sizeof(void*),
//      alignof <= alignof(void*)):  the callable's bytes live IN `ctx`, and
//      `invoke` is the per-type static invoker fn_word_invoke<F,...> which
//      reinterprets the (by-value) ctx word as F and calls it AS CONST.  Covers
//      the owner's [this] / [ptr] / [int] one-word lambdas.  Heap-free, native
//      call.  Gated on const-invocability: a callable whose call mutates its own
//      state (a `mutable` lambda) must observe that mutation across calls, and a
//      by-value ctx copy cannot provide it — such callables take mode 4 (heap,
//      mutated in place, standard semantics).  Residual caveat: a const-invocable
//      trivially-copyable one-word functor mutating a `mutable` MEMBER inside a
//      const call is undetectable and loses those mutations (lean/README.md).
//
//   2. PLAIN FUNCTION POINTER / capture-less lambda (convertible to the exact
//      R(*)(Args...)):  `ctx` holds the target function pointer and `invoke` is
//      ONE shared per-signature trampoline fn_direct_invoke<R,Args...> that
//      reinterprets ctx back to R(*)(Args...) and tail-calls it.  Heap-free.
//
//   3. EXTENSION CONSTRUCTOR  function(R (*fn)(T*, Args...), T* obj):  `ctx` is
//      `obj` and `invoke` is `fn` reinterpret_cast to R(*)(void*, Args...) — the
//      stored USER function IS the invoker, so there is ZERO per-type code and
//      ZERO hops.  This is the GCC bound-pointer-to-member-function cast shape
//      the owner's codebase uses pervasively.  Calling through the reinterpreted
//      type relies on T* and void* sharing an argument ABI (the same de-facto
//      contract the GCC pmf cast itself relies on).  static_assert is_object_v<T>.
//      (A lean extension, documented in lean/README.md — not standard.)
//
//   4. EVERYTHING ELSE (larger than one word incl. 2-word captures like [a,b],
//      over-aligned, or non-trivially-copyable):  a heap block holding a
//      { copy, destroy, real_invoke } header followed by the payload.  `ctx` is
//      the block and `invoke` is ONE shared per-signature heap_invoke<R,Args...>
//      that loads real_invoke from the header and tail-calls it with the block.
//      2-word-or-larger captures allocating is the documented SBO trade for the
//      2-word object (like string's SSO trade).
//
// COPY / DESTROY (cold paths) discriminate on `invoke`:
//   invoke == nullptr                     -> empty (nothing to do)
//   invoke == &heap_invoke<R,Args...>     -> deep copy / destroy via header ops
//   otherwise                             -> memcpy the two words / no-op destroy
// The heap discriminator is ONE address compare against the per-signature
// heap_invoke.  C++ vague linkage gives that inline function a single address
// program-wide, so the compare is exact; heap_invoke is kept default-visibility
// (the whole header is compiled under the lean default-visibility regime) so the
// identity holds across a normal DSO boundary.
//   CAVEAT: passing a function object across a boundary to a DSO that built
//   <functional> under HIDDEN visibility would give heap_invoke two addresses
//   and defeat the discriminator.  This is documented, not worked around (the
//   lean profile never builds its headers hidden).
//
// OMITTED (noted):
//   target() / target_type() — require typeid (RTTI); omitted under -fno-rtti
//   (base <functional> omits them the same way).
//
// Empty-function call: under -fno-exceptions, calling an empty function calls
//   __builtin_trap() instead of throwing bad_function_call.
//===----------------------------------------------------------------------===//

// bad_function_call: under -fno-exceptions this is never thrown, but the
// type keeps its standard shape (derives from std::exception, what()).
class bad_function_call : public exception {
public:
    const char* what() const noexcept override { return "std::bad_function_call"; }
};

// Forward declaration
template<class Fp>
class function;

namespace detail {

// null detection helpers for function wrappers (a null function pointer / member
// pointer / empty std::function target constructs an EMPTY function).
template<class Fp>
inline bool fn_is_null(const Fp&) noexcept { return false; }
template<class Fp>
inline bool fn_is_null(Fp* p) noexcept { return !p; }
template<class Ret, class Class>
inline bool fn_is_null(Ret Class::* p) noexcept { return !p; }
template<class Fp>
inline bool fn_is_null(const function<Fp>& f) noexcept { return !f; }

//===------------------------------------------------------------------------===
// The three type-erased invokers + the heap block, per the banner above.
//===------------------------------------------------------------------------===

// Mode 1 — one-word callable stored inside the ctx word (passed by value).
// Invoked as CONST: the init() gate admits only const-invocable callables here,
// which is what makes calling a by-value copy observationally equivalent to
// calling the stored object (mutating callables go to the heap block instead).
template<class F, class Rp, class... ArgTypes>
Rp fn_word_invoke(void* ctx, ArgTypes... args) {
    // `ctx` is a by-value copy of the stored word; F's bytes live in it.
    return std::invoke_r<Rp>(*reinterpret_cast<const F*>(&ctx), std::forward<ArgTypes>(args)...);
}

// Mode 2 — one shared trampoline per signature: ctx IS the target fn pointer.
template<class Rp, class... ArgTypes>
Rp fn_direct_invoke(void* ctx, ArgTypes... args) {
    using FP = Rp (*)(ArgTypes...);
    return std::invoke_r<Rp>(reinterpret_cast<FP>(ctx), std::forward<ArgTypes>(args)...);
}

// Mode 4 — heap block: the fn_heap_base header (bits/lean_fn.h) then the payload.
// KERNEL-VS-THUNK: a measurement (see the implementation report) showed routing
// the block malloc/free through the two shared kernels fn_block_clone /
// fn_block_free (bits/lean_fn.h, defined once in kernels.cpp) beats self-
// contained per-type malloc/free thunks — per-type heap cost 73 B vs 135 B, and
// smaller total text once ≥2 heap callable types share the fixed kernel cost.
// So the only per-type heap code is the three tiny thunks below (copy_ctor /
// dtor / real_invoke); the malloc/memcpy/free live once per binary.
template<class F>
struct fn_heap_block {
    fn_heap_base base;
    F payload;
};

// real_invoke thunk: knows F, so it recovers the payload from the block itself.
template<class F, class Rp, class... ArgTypes>
Rp fn_heap_real_invoke(void* block, ArgTypes... args) {
    auto* b = static_cast<fn_heap_block<F>*>(block);
    return std::invoke_r<Rp>(b->payload, std::forward<ArgTypes>(args)...);
}

// The two type-dependent block-header thunks (the only per-type heap code).
template<class F>
void fn_copy_ctor(const void* src_payload, void* dst_payload) {
    ::new (dst_payload) F(*static_cast<const F*>(src_payload));
}
template<class F>
void fn_dtor(void* payload) { static_cast<F*>(payload)->~F(); }

// One shared per-signature heap trampoline — its ADDRESS is the heap-mode
// discriminator, so it must be a distinct (non-inlined-away) function.  It loads
// the per-type real_invoke from the header and tail-calls it with the block.
template<class Rp, class... ArgTypes>
Rp heap_invoke(void* block, ArgTypes... args) {
    auto* b = static_cast<fn_heap_base*>(block);
    using RI = Rp (*)(void*, ArgTypes...);
    return reinterpret_cast<RI>(b->real_invoke)(block, std::forward<ArgTypes>(args)...);
}

// Cold-path helpers over the block header route to the shared kernels.
inline void* fn_block_copy(void* src) noexcept { return fn_block_clone(src); }
inline void fn_block_destroy(void* blk) noexcept { fn_block_free(blk); }

} // namespace detail

// function<R(Args...)>
template<class Rp, class... ArgTypes>
class function<Rp(ArgTypes...)> {
    void* ctx_ = nullptr;
    Rp (*invoke_)(void*, ArgTypes...) = nullptr;

    // The per-signature heap trampoline this instantiation compares against.
    static constexpr auto heap_tag = &detail::heap_invoke<Rp, ArgTypes...>;

    template<class Fp>
    using enable_if_callable = enable_if_t<
        !is_same_v<remove_cvref_t<Fp>, function> &&
        is_invocable_r_v<Rp, Fp&, ArgTypes...>>;

    // Populate ctx_/invoke_ from a decayed, known-non-null callable F.
    template<class F>
    void init(F&& f) {
        using DF = remove_cvref_t<F>;
        using FP = Rp (*)(ArgTypes...);
        if constexpr (is_convertible_v<DF, FP>) {
            // Mode 2: plain fn pointer / capture-less lambda -> store the fn ptr.
            FP fp = static_cast<FP>(f);
            if (fp == nullptr) { ctx_ = nullptr; invoke_ = nullptr; return; }
            ctx_ = reinterpret_cast<void*>(fp);
            invoke_ = &detail::fn_direct_invoke<Rp, ArgTypes...>;
        } else if constexpr (sizeof(DF) <= sizeof(void*) &&
                             alignof(DF) <= alignof(void*) &&
                             is_trivially_copyable_v<DF> &&
                             is_invocable_r_v<Rp, const DF&, ArgTypes...>) {
            // Mode 1: one-word trivially-copyable CONST-INVOCABLE callable lives
            // in the ctx word.  Non-const-invocable (mutable lambdas) fall to
            // mode 4 so their self-mutation persists across calls.
            ctx_ = nullptr;  // zero the pad bytes when sizeof(DF) < sizeof(void*)
            ::new (static_cast<void*>(&ctx_)) DF(std::move(f));
            invoke_ = &detail::fn_word_invoke<DF, Rp, ArgTypes...>;
        } else {
            // Mode 4: heap block.
            static_assert(alignof(DF) <= alignof(max_align_t),
                "lean std::function does not support over-aligned callables");
            using Block = detail::fn_heap_block<DF>;
            auto* b = static_cast<Block*>(::malloc(sizeof(Block)));
            if (!b) __builtin_trap();
            b->base.copy_ctor = &detail::fn_copy_ctor<DF>;
            b->base.dtor = &detail::fn_dtor<DF>;
            b->base.real_invoke = reinterpret_cast<void (*)()>(
                &detail::fn_heap_real_invoke<DF, Rp, ArgTypes...>);
            b->base.size = sizeof(Block);
            b->base.payoff = __builtin_offsetof(Block, payload);
            ::new (static_cast<void*>(&b->payload)) DF(std::move(f));
            ctx_ = b;
            invoke_ = heap_tag;
        }
    }

public:
    using result_type = Rp;

    // Constructors
    function() noexcept {}
    function(nullptr_t) noexcept {}

    function(const function& other) {
        invoke_ = other.invoke_;
        if (invoke_ == nullptr)        ctx_ = nullptr;
        else if (invoke_ == heap_tag)  ctx_ = detail::fn_block_copy(other.ctx_);
        else                           ctx_ = other.ctx_;   // memcpy the word
    }

    function(function&& other) noexcept
        : ctx_(other.ctx_), invoke_(other.invoke_) {
        other.ctx_ = nullptr;         // source becomes empty; heap ownership moves
        other.invoke_ = nullptr;
    }

    template<class Fp, class = enable_if_callable<Fp>>
    function(Fp f) {
        using DF = decay_t<Fp>;
        // std::function requires a CopyConstructible target — this rejects a
        // move-only callable at compile time (verified by a negative probe).
        static_assert(is_copy_constructible_v<DF>,
            "std::function target must be CopyConstructible");
        if (detail::fn_is_null(f)) return;  // null fn ptr / member ptr / function
        init<DF>(std::move(f));
    }

    // Lean EXTENSION (mode 3): a raw function taking the context object first.
    // The stored function IS the invoker — no per-type code, no hops.
    template<class T>
    function(Rp (*fn)(T*, ArgTypes...), T* obj) noexcept {
        static_assert(is_object_v<T>,
            "function(fn, obj): the context type must be an object type");
        ctx_ = const_cast<void*>(static_cast<const volatile void*>(obj));
        // Relies on T* and void* sharing an argument ABI (the GCC pmf-cast
        // contract); a null fn yields an empty function.
        invoke_ = reinterpret_cast<Rp (*)(void*, ArgTypes...)>(fn);
    }

    // Assignment (copy-and-swap; move builds an empty-leaving temp)
    function& operator=(const function& other) {
        function(other).swap(*this);
        return *this;
    }
    function& operator=(function&& other) noexcept {
        function(std::move(other)).swap(*this);
        return *this;
    }
    function& operator=(nullptr_t) noexcept {
        if (invoke_ == heap_tag) detail::fn_block_destroy(ctx_);
        ctx_ = nullptr;
        invoke_ = nullptr;
        return *this;
    }
    template<class Fp, class = enable_if_callable<decay_t<Fp>>>
    function& operator=(Fp&& f) {
        function(std::forward<Fp>(f)).swap(*this);
        return *this;
    }

    ~function() {
        if (invoke_ == heap_tag) detail::fn_block_destroy(ctx_);
    }

    // Modifiers — function is trivially relocatable, so swapping the two words
    // is a complete swap (heap payload is reached only through the block ptr).
    void swap(function& other) noexcept {
        void* tc = ctx_; ctx_ = other.ctx_; other.ctx_ = tc;
        auto ti = invoke_; invoke_ = other.invoke_; other.invoke_ = ti;
    }

    // Capacity
    explicit operator bool() const noexcept { return invoke_ != nullptr; }

    // Deleted comparisons
    template<class R2, class... A2>
    bool operator==(const function<R2(A2...)>&) const = delete;

    // Invocation — the whole hot path: null check, then one indirect call.
    Rp operator()(ArgTypes... args) const {
        if (invoke_ == nullptr)
            __builtin_trap();  // empty call: trap (no bad_function_call under -fno-exceptions)
        return invoke_(ctx_, std::forward<ArgTypes>(args)...);
    }

    // target() and target_type() are OMITTED (require typeid / RTTI; -fno-rtti),
    // exactly as the base <functional> omits them.
};

