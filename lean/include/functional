// perfect_forward_impl: stores a tuple of bound args, calls Op()(args..., call_args...)
namespace detail {

template<class Op, class Indices, class... BoundArgs>
struct perfect_forward_impl;

template<class Op, size_t... Idx, class... BoundArgs>
struct perfect_forward_impl<Op, index_sequence<Idx...>, BoundArgs...> {
private:
    tuple<BoundArgs...> bound_args_;

public:
    template<class... Args>
        requires is_constructible_v<tuple<BoundArgs...>, Args&&...>
    explicit constexpr perfect_forward_impl(Args&&... bound_args)
        : bound_args_(std::forward<Args>(bound_args)...) {}

    perfect_forward_impl(const perfect_forward_impl&) = default;
    perfect_forward_impl(perfect_forward_impl&&)      = default;
    perfect_forward_impl& operator=(const perfect_forward_impl&) = default;
    perfect_forward_impl& operator=(perfect_forward_impl&&)      = default;

    // &
    template<class... Args>
        requires is_invocable_v<Op, BoundArgs&..., Args...>
    constexpr auto operator()(Args&&... args) &
        noexcept(noexcept(Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...)))
        -> decltype(Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...))
    { return Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...); }

    template<class... Args>
        requires (!is_invocable_v<Op, BoundArgs&..., Args...>)
    void operator()(Args&&...) & = delete;

    // const &
    template<class... Args>
        requires is_invocable_v<Op, const BoundArgs&..., Args...>
    constexpr auto operator()(Args&&... args) const&
        noexcept(noexcept(Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...)))
        -> decltype(Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...))
    { return Op()(std::get<Idx>(bound_args_)..., std::forward<Args>(args)...); }

    template<class... Args>
        requires (!is_invocable_v<Op, const BoundArgs&..., Args...>)
    void operator()(Args&&...) const& = delete;

    // &&
    template<class... Args>
        requires is_invocable_v<Op, BoundArgs..., Args...>
    constexpr auto operator()(Args&&... args) &&
        noexcept(noexcept(Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...)))
        -> decltype(Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...))
    { return Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...); }

    template<class... Args>
        requires (!is_invocable_v<Op, BoundArgs..., Args...>)
    void operator()(Args&&...) && = delete;

    // const &&
    template<class... Args>
        requires is_invocable_v<Op, const BoundArgs..., Args...>
    constexpr auto operator()(Args&&... args) const&&
        noexcept(noexcept(Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...)))
        -> decltype(Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...))
    { return Op()(std::get<Idx>(std::move(bound_args_))..., std::forward<Args>(args)...); }

    template<class... Args>
        requires (!is_invocable_v<Op, const BoundArgs..., Args...>)
    void operator()(Args&&...) const&& = delete;
};

template<class Op, class... Args>
using perfect_forward = perfect_forward_impl<Op, index_sequence_for<Args...>, Args...>;

} // namespace detail

// not_fn_op: calls !std::invoke(fn, args...)
namespace detail {
struct not_fn_op {
    template<class... Args>
    constexpr auto operator()(Args&&... args) const
        noexcept(noexcept(!std::invoke(std::forward<Args>(args)...)))
        -> decltype(!std::invoke(std::forward<Args>(args)...))
    { return !std::invoke(std::forward<Args>(args)...); }
};
} // namespace detail

template<class Fn>
struct not_fn_t : detail::perfect_forward<detail::not_fn_op, Fn> {
    using detail::perfect_forward<detail::not_fn_op, Fn>::perfect_forward;
};

template<class Fn>
    requires is_constructible_v<decay_t<Fn>, Fn> && is_move_constructible_v<decay_t<Fn>>
constexpr auto not_fn(Fn&& f) {
    return not_fn_t<decay_t<Fn>>(std::forward<Fn>(f));
}

//===----------------------------------------------------------------------===//
// bind_front (C++20)
// (from libc++ __functional/bind_front.h)
//===----------------------------------------------------------------------===//

namespace detail {
struct bind_front_op {
    template<class... Args>
    constexpr auto operator()(Args&&... args) const
        noexcept(noexcept(std::invoke(std::forward<Args>(args)...)))
        -> decltype(std::invoke(std::forward<Args>(args)...))
    { return std::invoke(std::forward<Args>(args)...); }
};
} // namespace detail

template<class Fn, class... BoundArgs>
struct bind_front_t : detail::perfect_forward<detail::bind_front_op, Fn, BoundArgs...> {
    using detail::perfect_forward<detail::bind_front_op, Fn, BoundArgs...>::perfect_forward;
};

template<class Fn, class... Args>
    requires is_constructible_v<decay_t<Fn>, Fn> &&
             is_move_constructible_v<decay_t<Fn>> &&
             (is_constructible_v<decay_t<Args>, Args> && ...) &&
             (is_move_constructible_v<decay_t<Args>> && ...)
[[nodiscard]] constexpr auto bind_front(Fn&& f, Args&&... args) {
    return bind_front_t<decay_t<Fn>, decay_t<Args>...>(
        std::forward<Fn>(f), std::forward<Args>(args)...);
}

